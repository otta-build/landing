---
import { pipelineStages } from "../data/content";
---

<section id="pipeline" class="otta-section">
<div class="mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 sm:py-24">
  <div class="max-w-3xl">
    <p class="otta-eyebrow">
      The pipeline
    </p>
    <h2 class="mt-3 text-3xl font-bold tracking-[-0.03em] text-white sm:text-5xl">
      Intent in. Verified release out.
    </h2>
    <p class="mt-5 text-lg leading-relaxed text-zinc-400">
      Five delivery stages keep the issue, implementation, independent review,
      GitHub evidence, and release verification connected without pretending
      they are one agent action.
    </p>
  </div>

  <ol class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {
      pipelineStages.map(stage => (
        <li class="otta-card flex flex-col rounded-2xl p-6 transition-colors">
          <div class="flex items-center gap-3">
            <span class="font-mono text-sm font-bold text-indigo-300">{stage.step}</span>
            <h3 class="text-lg font-semibold text-white">{stage.name}</h3>
          </div>
          <p class="mt-3 font-medium text-zinc-100">{stage.summary}</p>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-400">{stage.detail}</p>
          <div class="mt-5 flex items-start gap-2 rounded-xl border border-indigo-400/15 bg-indigo-500/8 px-3 py-3">
            <svg class="mt-0.5 h-4 w-4 flex-none text-indigo-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M2.5 10a7.5 7.5 0 1 1 15 0 7.5 7.5 0 0 1-15 0Zm10.7-1.8a1 1 0 0 0-1.4-1.4L9 9.6 7.7 8.3a1 1 0 0 0-1.4 1.4l2 2a1 1 0 0 0 1.4 0l3.5-3.5Z" clip-rule="evenodd" />
            </svg>
            <span class="text-xs font-semibold leading-relaxed text-indigo-100">{stage.enforces}</span>
          </div>
        </li>
      ))
    }
  </ol>
</div>
</section>
