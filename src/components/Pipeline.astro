---
import { pipelineStages } from "../data/content";
---

<section id="pipeline" class="mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 sm:py-24">
  <div class="max-w-3xl">
    <p class="text-sm font-semibold tracking-wide text-indigo-600 uppercase">
      The pipeline
    </p>
    <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
      Intent in. Verified release out.
    </h2>
    <p class="mt-4 text-lg text-gray-600">
      Six stages, each with a gate that can’t be skipped. You step in twice —
      to approve the plan and to approve the promote. Everything between runs
      autonomously, and every gate is enforced as a GitHub Check before code
      moves: fast on the way to staging, strict on the way to production.
    </p>
  </div>

  <ol class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {
      pipelineStages.map(stage => (
        <li class="flex flex-col rounded-2xl border border-gray-200 bg-white p-6">
          <div class="flex items-center gap-3">
            <span class="font-mono text-sm font-bold text-indigo-600">{stage.step}</span>
            <h3 class="text-lg font-semibold text-gray-900">{stage.name}</h3>
          </div>
          <p class="mt-3 font-medium text-gray-900">{stage.summary}</p>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-gray-600">{stage.detail}</p>
          <div class="mt-4 flex items-start gap-2 rounded-lg bg-indigo-50 px-3 py-2.5">
            <svg class="mt-0.5 h-4 w-4 flex-none text-indigo-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M2.5 10a7.5 7.5 0 1 1 15 0 7.5 7.5 0 0 1-15 0Zm10.7-1.8a1 1 0 0 0-1.4-1.4L9 9.6 7.7 8.3a1 1 0 0 0-1.4 1.4l2 2a1 1 0 0 0 1.4 0l3.5-3.5Z" clip-rule="evenodd" />
            </svg>
            <span class="text-xs font-semibold text-indigo-900">{stage.enforces}</span>
          </div>
        </li>
      ))
    }
  </ol>
</section>
