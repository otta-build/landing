---
import { differentiators } from "../data/content";
---

<section class="border-y border-gray-100 bg-gray-50">
  <div class="mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold tracking-wide text-indigo-600 uppercase">
        Why it’s different
      </p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        Autonomy you can actually trust.
      </h2>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        differentiators.map(d => (
          <article class="rounded-2xl border border-gray-200 bg-white p-6">
            <h3 class="text-lg font-semibold text-gray-900">{d.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-gray-600">{d.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
