---
import { differentiators } from "../data/content";
---

<section class="border-y border-zinc-900 bg-zinc-900/30">
  <div class="mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="max-w-3xl">
      <p class="reveal text-sm font-semibold tracking-wide text-indigo-400 uppercase">
        Why it's different
      </p>
      <h2 class="reveal reveal-d1 mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Autonomy you can actually trust.
      </h2>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        differentiators.map((d, i) => (
          <article class={`reveal reveal-d${Math.min(i+1,6)} rounded-2xl border border-zinc-800/60 bg-zinc-950/80 p-6 transition-colors hover:border-indigo-500/20`}>
            <h3 class="text-lg font-semibold text-white">{d.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-zinc-400">{d.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
