---
import { differentiators } from "../data/content";
---

<section class="otta-section bg-white/[0.018]">
  <div class="mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="max-w-3xl">
      <p class="otta-eyebrow">
        Why it’s different
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-[-0.03em] text-white sm:text-5xl">
        Control that travels with the work.
      </h2>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        differentiators.map(d => (
          <article class="otta-card rounded-2xl p-6 transition-all hover:-translate-y-0.5">
            <h3 class="text-lg font-semibold text-white">{d.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-zinc-400">{d.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
