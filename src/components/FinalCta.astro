---
import { SITE } from "../config";
---

<section class="otta-section mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 sm:py-24">
  <div class="relative overflow-hidden rounded-3xl border border-indigo-300/20 bg-gradient-to-br from-indigo-500/15 via-white/[0.035] to-purple-500/10 px-6 py-12 text-center shadow-2xl shadow-indigo-950/20 sm:px-12 sm:py-16">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(165,144,255,.18),transparent_48%)]"></div>
    <h2 class="relative mx-auto max-w-2xl text-3xl font-bold tracking-[-0.035em] text-white sm:text-5xl">
      Keep the speed. Make completion demonstrable.
    </h2>
    <p class="relative mx-auto mt-5 max-w-xl text-lg leading-relaxed text-zinc-400">
      Request early access, or book a walkthrough to see the specialist stages,
      Pulse gates, and lifecycle evidence in action.
    </p>
    <div class="relative mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href={SITE.waitlistUrl}
        class="rounded-xl bg-indigo-500 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-indigo-400"
      >
        Get access
      </a>
      <a
        href={SITE.bookingUrl}
        class="rounded-xl border border-white/15 bg-white/[0.035] px-6 py-3 text-sm font-semibold text-zinc-200 transition-colors hover:border-white/30 hover:bg-white/[0.07]"
      >
        Book a walkthrough
      </a>
    </div>
  </div>
</section>
