---
import type { PricingTier } from "../data/pricing";
const { tier, wide = false } = Astro.props as { tier: PricingTier; wide?: boolean };
---

<article
  class:list={[
    "relative flex flex-col rounded-2xl border bg-white p-6",
    tier.featured
      ? "border-emerald-600 shadow-lg ring-1 ring-emerald-600"
      : "border-gray-200",
  ]}
>
  {tier.featured && (
    <span class="absolute -top-3 left-6 rounded-full bg-emerald-600 px-3 py-1 text-xs font-semibold text-white">
      Popular
    </span>
  )}

  <div class="mb-1 font-mono text-xs text-gray-400">{tier.index}</div>
  <h3 class="text-xl font-semibold text-gray-900">{tier.name}</h3>

  <div class="mt-4 flex items-baseline gap-1">
    <span class="text-4xl font-bold tracking-tight text-gray-900">{tier.price}</span>
    {tier.period && <span class="text-sm text-gray-500">{tier.period}</span>}
  </div>

  <p class="mt-3 min-h-[40px] text-sm text-gray-600">{tier.blurb}</p>

  <a
    href={tier.cta.href}
    class:list={[
      "mt-5 block rounded-lg px-4 py-2.5 text-center text-sm font-semibold transition-colors",
      tier.featured
        ? "bg-emerald-600 text-white hover:bg-emerald-500"
        : "bg-gray-900 text-white hover:bg-gray-700",
    ]}
  >
    {tier.cta.label}
  </a>

  <div class="mt-6 border-t border-gray-100 pt-5">
    {tier.featuresLead && (
      <p class="mb-3 text-sm font-medium text-gray-900">{tier.featuresLead}</p>
    )}
    <ul class:list={["space-y-3", wide && "sm:grid sm:grid-cols-2 sm:gap-x-8 sm:gap-y-3 sm:space-y-0 lg:grid-cols-3"]}>
      {tier.features.map((feature) => (
        <li class="flex items-start gap-2 text-sm text-gray-600">
          <svg
            class="mt-0.5 h-4 w-4 flex-none text-emerald-600"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.5 7.6a1 1 0 0 1-1.42.006l-3.5-3.48a1 1 0 1 1 1.41-1.42l2.79 2.774 6.79-6.882a1 1 0 0 1 1.414-.006Z"
              clip-rule="evenodd"
            />
          </svg>
          <span>{feature}</span>
        </li>
      ))}
    </ul>
  </div>
</article>
