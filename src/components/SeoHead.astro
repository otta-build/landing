---
// Reusable SEO/GEO head — canonical source for the Otta site set.
// Mirrors the proven fruitfulcode SeoHead pattern; copy-deployable to the other
// Astro sites (petrenko.cv, leadcognition, dataforgtm once migrated).
import { BRAND, SITE } from "../config";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  type?: "website" | "article";
  robots?: string;
}

const {
  title,
  description = SITE.subtitle,
  canonicalPath,
  image = "/og-otta-preview-2026-06-23.png",
  type = "website",
  robots,
} = Astro.props;

const base = SITE.website.replace(/\/$/, "");
const canonicalUrl = canonicalPath ? base + canonicalPath : SITE.website;
const imageUrl = image.startsWith("http") ? image : base + image;

// Optional GA4 — OFF by default (PostHog is the primary analytics; GA4 adds
// Google-ecosystem signals + consent overhead). Set PUBLIC_GA_ID to enable.
const GA_ID = import.meta.env.PUBLIC_GA_ID;
---

<title>{title}</title>
<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}
<link rel="canonical" href={canonicalUrl} />

<meta property="og:site_name" content={BRAND} />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{GA_ID && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ gaId: GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}
