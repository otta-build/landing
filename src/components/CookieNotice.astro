---
/**
 * Reusable cookie / privacy notice — the policy page the consent banner links to.
 *
 * Renders a standard, factual cookie notice (what's collected, GA4 + consent,
 * how to change consent). Parameterize per site and mount at a route (e.g.
 * src/pages/privacy.astro), then pass that path as <ConsentBanner privacyUrl>.
 *
 * This is a plain-language template, not bespoke legal advice — review before
 * publishing, and add anything your jurisdiction requires.
 */
interface Props {
  /** Public site name, e.g. "LeadCognition". */
  siteName: string;
  /** Bare domain, e.g. "leadcognition.io". */
  domain: string;
  /** Contact email for privacy requests. */
  contactEmail: string;
  /** ISO date this notice was last updated, e.g. "2026-07-15". */
  updated?: string;
}
const { siteName, domain, contactEmail, updated } = Astro.props;
---

<article class="cookie-notice">
  <h1>Cookie &amp; Privacy Notice</h1>
  {updated && <p class="cookie-notice__meta">Last updated: {updated}</p>}

  <p>
    This notice explains how <strong>{siteName}</strong> ({domain}) uses cookies and
    similar technologies, and how you control them.
  </p>

  <h2>Consent-first</h2>
  <p>
    Non-essential cookies (analytics and advertising measurement) are <strong>off by
    default</strong>. Nothing that stores or reads advertising or analytics identifiers
    runs until you choose <em>Accept</em> in our cookie banner. This is implemented with
    Google Consent Mode v2 — before you accept, measurement runs in a cookieless,
    non-identifying mode; after you accept, full measurement is enabled.
  </p>

  <h2>What we use</h2>
  <ul>
    <li>
      <strong>Google Analytics 4</strong> (via Google Tag Manager) — aggregate traffic
      and usage measurement. Only active after consent.
    </li>
    <li>
      <strong>Advertising measurement</strong> — if we run ads, tags measure which
      campaigns lead to visits. Only active after consent (advertising storage).
    </li>
    <li>
      <strong>Strictly necessary</strong> — a small record of your consent choice, so we
      don't ask again every visit. This is always present and stores no personal data.
    </li>
  </ul>

  <h2>Changing your choice</h2>
  <p>
    Clear this site's cookies/site data in your browser to be shown the banner again, or
    use your browser's cookie controls to block cookies for {domain}.
  </p>

  <h2>Contact</h2>
  <p>
    Questions or requests about your data: <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
  </p>
</article>

<style>
  .cookie-notice {
    max-width: 44rem;
    margin: 0 auto;
    padding: 3rem 1.25rem;
    font-family: Satoshi, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    line-height: 1.6;
    color: hsl(220, 20%, 14%);
  }
  .cookie-notice h1 { font-size: 1.9rem; margin: 0 0 0.5rem; }
  .cookie-notice h2 { font-size: 1.2rem; margin: 2rem 0 0.5rem; }
  .cookie-notice__meta { color: hsl(220, 10%, 46%); font-size: 0.9rem; margin: 0 0 1.5rem; }
  .cookie-notice ul { padding-left: 1.25rem; }
  .cookie-notice li { margin: 0.4rem 0; }
  .cookie-notice a { color: hsl(170, 65%, 30%); }
  @media (prefers-color-scheme: dark) {
    .cookie-notice { color: hsl(220, 15%, 88%); }
    .cookie-notice a { color: hsl(170, 55%, 60%); }
  }
</style>
