---
import { BRAND } from "../config";
---

<section id="waitlist" class="otta-section relative overflow-hidden py-20 sm:py-28">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_55%,rgba(89,70,210,.18),transparent_38%)]"></div>
  <div class="mx-auto w-full max-w-2xl px-4 text-center sm:px-6">
    <p class="otta-eyebrow">Early access</p>
    <h2 class="mt-3 text-3xl font-bold tracking-[-0.035em] text-white sm:text-5xl">
      Get access to {BRAND}
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-zinc-400">
      Bring disciplined acceptance, specialist review, visual proof, and Pulse
      evidence to the coding agents your team already uses.
    </p>

    <form id="waitlist-form" class="mx-auto mt-8 flex max-w-md flex-col gap-3 sm:flex-row">
      <label for="waitlist-email" class="sr-only">Email address</label>
      <input
        id="waitlist-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@company.com"
        class="w-full flex-1 rounded-xl border border-white/15 bg-white/[0.055] px-4 py-3 text-sm text-white placeholder:text-zinc-500 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/40"
      />
      <button
        type="submit"
        class="rounded-xl bg-indigo-500 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-indigo-400 disabled:opacity-60"
      >
        Get access
      </button>
    </form>
    <p id="waitlist-status" class="mt-3 min-h-5 text-sm" role="status" aria-live="polite"></p>
  </div>
</section>

<script>
  const form = document.getElementById("waitlist-form") as HTMLFormElement | null;
  const status = document.getElementById("waitlist-status");
  const btn = form?.querySelector("button");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status || !btn) return;
    const email = new FormData(form).get("email");
    btn.setAttribute("disabled", "true");
    status.textContent = "Adding you…";
    status.className = "mt-3 min-h-5 text-sm text-slate-400";
    try {
      const res = await fetch("/api/waitlist", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();
      if (res.ok) {
        if (typeof window !== "undefined" && (window as any).posthog) {
          (window as any).posthog.capture('get_access_requested', { email });
        }
        status.textContent = data.already
          ? "You've already requested access — we'll be in touch soon."
          : "Access request received! We'll be in touch.";
        status.className = "mt-3 min-h-5 text-sm text-indigo-400";
        form.reset();
      } else {
        status.textContent = data.error || "Something went wrong. Try again.";
        status.className = "mt-3 min-h-5 text-sm text-rose-400";
        btn.removeAttribute("disabled");
      }
    } catch {
      status.textContent = "Network error. Try again.";
      status.className = "mt-3 min-h-5 text-sm text-rose-400";
      btn.removeAttribute("disabled");
    }
  });
</script>
