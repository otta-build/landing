---
import { memoryLayers } from "../data/content";
---

<section class="otta-section">
<div class="mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 sm:py-24">
  <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
    <div>
      <p class="otta-eyebrow">
        Evidence spine
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-[-0.03em] text-white sm:text-5xl">
        A delivery record that outlives the agent run.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-zinc-400">
        Prompts end. GitHub events, acceptance evidence, release tags, and
        reviewed learning receipts remain inspectable for the next person or agent.
      </p>
    </div>

    <div class="grid gap-4">
      {
        memoryLayers.map(layer => (
          <article class="otta-card rounded-2xl p-6 sm:flex sm:items-start sm:gap-6">
            <div class="sm:w-40 sm:flex-none">
              <h3 class="text-lg font-semibold text-white">{layer.name}</h3>
              <p class="mt-1 text-xs font-semibold text-indigo-300">{layer.role}</p>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400 sm:mt-0">{layer.detail}</p>
          </article>
        ))
      }
    </div>
  </div>
</div>
</section>
