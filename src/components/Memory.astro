---
import { memoryLayers, flywheel } from "../data/content";
---

<section class="mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 sm:py-24">
  <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
    <div>
      <p class="text-sm font-semibold tracking-wide text-indigo-600 uppercase">
        Memory &amp; measurement
      </p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        It remembers your codebase — and measures every run on it.
      </h2>
      <p class="mt-4 text-lg text-gray-600">
        Most coding agents start every task from a blank slate and re-make the
        same mistakes. Here, hard-won context is captured, versioned, and recalled
        — and every run is recorded with its real cost — so the system has
        what it needs to get sharper the longer it works on your code.
      </p>
    </div>

    <div class="grid gap-4">
      {
        memoryLayers.map(layer => (
          <article class="rounded-2xl border border-gray-200 bg-white p-6 sm:flex sm:items-start sm:gap-6">
            <div class="sm:w-40 sm:flex-none">
              <h3 class="text-lg font-semibold text-gray-900">{layer.name}</h3>
              <p class="mt-1 text-xs font-semibold text-indigo-600">{layer.role}</p>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-gray-600 sm:mt-0">{layer.detail}</p>
          </article>
        ))
      }
    </div>
  </div>

  <!-- the flywheel: execute → measure (live) → learn → improve (roadmap) -->
  <div class="mt-16 rounded-2xl border border-gray-200 bg-gray-50 p-6 sm:p-10">
    <p class="text-sm font-semibold tracking-wide text-indigo-600 uppercase">
      {flywheel.eyebrow}
    </p>
    <h3 class="mt-2 max-w-3xl text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
      {flywheel.heading}
    </h3>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-gray-600">
      {flywheel.body}
    </p>

    <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        flywheel.steps.map((s, i) => (
          <li class="rounded-xl border border-gray-200 bg-white p-5">
            <div class="flex items-center justify-between">
              <span class="font-mono text-sm font-bold text-indigo-600">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span
                class={
                  s.live
                    ? "rounded-full bg-indigo-50 px-2 py-0.5 text-[11px] font-semibold text-indigo-700"
                    : "rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-semibold text-gray-500"
                }
              >
                {s.live ? "Live today" : "On the roadmap"}
              </span>
            </div>
            <h4 class="mt-3 text-base font-semibold text-gray-900">{s.name}</h4>
            <p class="mt-1 text-sm leading-relaxed text-gray-600">{s.detail}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
