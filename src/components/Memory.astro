---
import { memoryLayers } from "../data/content";
---

<section class="bg-zinc-950 px-4 py-16 sm:px-6 sm:py-24">
  <div class="mx-auto w-full max-w-7xl">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
      <div>
        <p class="reveal text-sm font-semibold tracking-wide text-indigo-400 uppercase">
          Memory
        </p>
        <h2 class="reveal reveal-d1 mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Agents that remember your codebase — not just your last session.
        </h2>
        <p class="reveal reveal-d2 mt-4 text-lg text-zinc-400">
          Most coding agents start every task from a blank slate and re-make the
          same mistakes. Here, hard-won context is captured, versioned, and recalled
          — so the system gets sharper the longer it works on your code.
        </p>
      </div>

      <div class="grid gap-4">
        {
          memoryLayers.map(layer => (
            <article class="reveal rounded-2xl border border-zinc-800/60 bg-zinc-900/40 p-6 sm:flex sm:items-start sm:gap-6 transition-colors hover:border-indigo-500/20">
              <div class="sm:w-40 sm:flex-none">
                <h3 class="text-lg font-semibold text-white">{layer.name}</h3>
                <p class="mt-1 text-xs font-semibold text-indigo-400">{layer.role}</p>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-zinc-400 sm:mt-0">{layer.detail}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
