---
import { BRAND, SITE } from "../config";
import { proofMetrics } from "../data/content";
---

<section class="relative overflow-hidden bg-slate-950 text-white">
  <!-- grid backdrop -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.18]"
    style="background-image: linear-gradient(rgba(99,102,241,.25) 1px, transparent 1px), linear-gradient(90deg, rgba(99,102,241,.25) 1px, transparent 1px); background-size: 44px 44px;"
  >
  </div>
  <div
    class="pointer-events-none absolute -top-24 right-0 h-96 w-96 rounded-full bg-indigo-600/30 blur-3xl"
  >
  </div>

  <div class="relative mx-auto w-full max-w-7xl px-4 pt-20 pb-16 sm:px-6 sm:pt-28 sm:pb-20">
    <h1 class="max-w-4xl text-4xl font-bold tracking-tight sm:text-6xl lg:text-7xl">
      {SITE.tagline}
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
      {SITE.subtitle}
    </p>

    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a
        href="#get-started"
        class="rounded-lg bg-indigo-500 px-6 py-3 text-center text-sm font-semibold text-white transition-colors hover:bg-indigo-400"
      >
        Get started
      </a>
      <a
        href={SITE.bookingUrl}
        class="rounded-lg border border-white/20 px-6 py-3 text-center text-sm font-semibold text-white transition-colors hover:border-white/40 hover:bg-white/5"
      >
        Book a walkthrough
      </a>
    </div>

    <!-- proof strip -->
    <div class="mt-14 border-t border-white/10 pt-8">
      <p class="text-xs font-medium tracking-wide text-slate-400 uppercase">
        Proven shipping a real production SaaS — last 90 days
      </p>
      <div class="mt-5 grid grid-cols-2 gap-x-6 gap-y-6 sm:grid-cols-3 lg:grid-cols-6">
        {
          proofMetrics.map(m => (
            <div>
              <div class="text-2xl font-bold sm:text-3xl">{m.value}</div>
              <div class="mt-1 text-xs font-semibold text-indigo-300">{m.label}</div>
              <div class="text-xs text-slate-500">{m.sub}</div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
