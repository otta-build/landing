---
import { BRAND, SITE } from "../config";
import { proofMetrics } from "../data/content";
---

<section class="relative overflow-hidden bg-slate-950 text-white border-b border-white/5 py-16 sm:py-20 lg:py-24">
  <!-- subtle grid background with soft indigo radial glow -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.12]"
    style="background-image: linear-gradient(rgba(99,102,241,.25) 1px, transparent 1px), linear-gradient(90deg, rgba(99,102,241,.25) 1px, transparent 1px); background-size: 44px 44px;"
  >
  </div>
  <div class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-[600px] w-[600px] rounded-full bg-indigo-500/10 blur-[130px]"></div>

  <div class="relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Top Row: Split Hero (Value Prop Left, Live Dashboard Right) -->
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center">
      
      <!-- Left side: Hybrid Copywriting (C Flywheel + A Governance) -->
      <div class="lg:col-span-7 space-y-6">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-500/10 px-3 py-1 text-xs font-semibold text-indigo-300 ring-1 ring-inset ring-indigo-500/20">
          <span class="h-1.5 w-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
          GOVERNANCE & OBSERVABILITY LAYER
        </span>
        
        <h1 class="text-4xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl leading-none uppercase">
          Execute. Measure. Learn. Improve.
        </h1>
        
        <p class="text-lg leading-relaxed text-slate-300 font-light">
          Otta is the governance and observability layer that turns AI coding into an engineering discipline. Keep using Copilot App, Claude Code, or Codex—Otta gates them, measures them, and builds a continuous quality flywheel.
        </p>

        <div class="space-y-4 text-sm text-slate-400 pt-2">
          <div class="flex items-start gap-2.5">
            <svg class="h-5 w-5 text-indigo-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span><strong>Bring your own agent:</strong> Full out-of-the-box support for Copilot App, Claude Code, and Codex. Otta is executor-agnostic.</span>
          </div>
          <div class="flex items-start gap-2.5">
            <svg class="h-5 w-5 text-indigo-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span><strong>Opinionated merge-blocking gates:</strong> Enforce test-driven code and visual proof before merging. Prompts drift, gates don't.</span>
          </div>
          <div class="flex items-start gap-2.5">
            <svg class="h-5 w-5 text-indigo-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span><strong>Continuous learning flywheel:</strong> Successes and gotchas automatically compile into your git-canonical brain and recall bus.</span>
          </div>
        </div>

        <div class="flex flex-col gap-3.5 sm:flex-row pt-4">
          <a
            href={SITE.waitlistUrl}
            class="rounded-lg bg-indigo-500 px-6 py-3.5 text-center text-sm font-semibold text-white transition-all hover:bg-indigo-400 hover:scale-[1.02] shadow-lg shadow-indigo-500/20"
          >
            Install the Otta GitHub App
          </a>
          <a
            href={SITE.bookingUrl}
            class="rounded-lg border border-white/10 px-6 py-3.5 text-center text-sm font-semibold text-white transition-colors hover:border-white/20 hover:bg-white/5"
          >
            Book a walkthrough
          </a>
        </div>
      </div>

      <!-- Right side: Visual Dashboard Widget (from A) -->
      <div class="lg:col-span-5">
        <div class="rounded-xl border border-white/10 bg-slate-900/60 backdrop-blur p-5 shadow-2xl">
          <!-- Widget Header -->
          <div class="flex items-center justify-between border-b border-white/5 pb-4">
            <div class="flex items-center gap-2">
              <span class="flex h-2 w-2 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span class="text-xs font-semibold tracking-wider uppercase text-slate-300">Otta Controller (Active)</span>
            </div>
            <span class="rounded bg-indigo-500/10 px-2 py-0.5 text-[10px] font-bold text-indigo-300 uppercase">Gated Mode</span>
          </div>

          <!-- Active Job -->
          <div class="mt-4 space-y-3">
            <div class="rounded-lg bg-slate-950/80 p-3.5 border border-white/5">
              <div class="flex items-center justify-between text-xs text-slate-400">
                <span>ACTIVE EXECUTOR</span>
                <span class="font-mono text-[10px] text-indigo-400">claude-code-v1</span>
              </div>
              <div class="mt-1 text-sm font-semibold text-white flex items-center justify-between">
                <span>Task: Implement LC-920 Growth Engine</span>
                <span class="rounded bg-slate-800 px-1.5 py-0.5 text-[10px] font-medium text-slate-300">PR #210</span>
              </div>
            </div>

            <!-- Gating Pipeline Status -->
            <div class="space-y-2 pt-1">
              <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Merge-Blocking Gates</div>
              
              <div class="flex items-center justify-between rounded-md bg-emerald-500/5 px-3 py-2 border border-emerald-500/10">
                <div class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" />
                  </svg>
                  <span class="text-xs text-slate-200">Test-First TDD Validator</span>
                </div>
                <span class="text-[10px] font-mono font-semibold text-emerald-400">PASSED</span>
              </div>

              <div class="flex items-center justify-between rounded-md bg-emerald-500/5 px-3 py-2 border border-emerald-500/10">
                <div class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" />
                  </svg>
                  <span class="text-xs text-slate-200">Visual Verification (Desktop+Mobile)</span>
                </div>
                <span class="text-[10px] font-mono font-semibold text-emerald-400">PASSED (8 shots)</span>
              </div>

              <div class="flex items-center justify-between rounded-md bg-amber-500/5 px-3 py-2 border border-amber-500/10">
                <div class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full bg-amber-400 animate-pulse shrink-0"></span>
                  <span class="text-xs text-slate-200">GIVEN/WHEN/THEN Criteria Check</span>
                </div>
                <span class="text-[10px] font-mono font-semibold text-amber-400">VERIFYING...</span>
              </div>
            </div>

            <!-- Dashboard Stats Grid -->
            <div class="grid grid-cols-2 gap-2.5 pt-3 border-t border-white/5">
              <div class="rounded-lg bg-slate-950/40 p-2.5 text-center">
                <div class="text-[10px] text-slate-500 uppercase font-semibold">Defect-Free Ship</div>
                <div class="text-lg font-bold text-white mt-0.5">100%</div>
              </div>
              <div class="rounded-lg bg-slate-950/40 p-2.5 text-center">
                <div class="text-[10px] text-slate-500 uppercase font-semibold">Gates Bypassed</div>
                <div class="text-lg font-bold text-rose-400 mt-0.5">0</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Row: Horizontal Flywheel Pipeline (from C) formatted in neat cards -->
    <div class="mt-20">
      <div class="text-xs font-semibold tracking-wider text-slate-400 uppercase border-b border-white/5 pb-3">// THE CONTINUOUS LEARNING FLYWHEEL</div>
      <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Card 1 -->
        <div class="rounded-xl border border-white/5 bg-slate-900/30 p-5 relative overflow-hidden group hover:border-indigo-500/10 transition-all">
          <div class="absolute top-0 right-0 p-3 font-mono text-4xl font-black text-white/5 group-hover:text-indigo-500/10 transition-colors">01</div>
          <span class="rounded bg-indigo-500/10 border border-indigo-500/20 px-2 py-0.5 font-mono text-[10px] text-indigo-300 font-semibold uppercase">01 / Execute</span>
          <h3 class="mt-4 text-base font-bold text-white">Bring your agent</h3>
          <p class="mt-2 text-xs text-slate-400 leading-relaxed">
            Keep using Copilot App, Claude Code, or Codex. Otta is executor-agnostic—observing them where they work, without replacing your cockpit.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="rounded-xl border border-white/5 bg-slate-900/30 p-5 relative overflow-hidden group hover:border-indigo-500/10 transition-all">
          <div class="absolute top-0 right-0 p-3 font-mono text-4xl font-black text-white/5 group-hover:text-indigo-500/10 transition-colors">02</div>
          <span class="rounded bg-indigo-500/10 border border-indigo-500/20 px-2 py-0.5 font-mono text-[10px] text-indigo-300 font-semibold uppercase">02 / Measure</span>
          <h3 class="mt-4 text-base font-bold text-white">Enforce the gates</h3>
          <p class="mt-2 text-xs text-slate-400 leading-relaxed">
            Every run is test-driven. Failing tests, strict typechecks, and visual screenshot verification are enforced as merge-blocking gates.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="rounded-xl border border-white/5 bg-slate-900/30 p-5 relative overflow-hidden group hover:border-indigo-500/10 transition-all">
          <div class="absolute top-0 right-0 p-3 font-mono text-4xl font-black text-white/5 group-hover:text-indigo-500/10 transition-colors">03</div>
          <span class="rounded bg-indigo-500/10 border border-indigo-500/20 px-2 py-0.5 font-mono text-[10px] text-indigo-300 font-semibold uppercase">03 / Learn</span>
          <h3 class="mt-4 text-base font-bold text-white">Compile the brain</h3>
          <p class="mt-2 text-xs text-slate-400 leading-relaxed">
            Otta records successes, gotchas, and refactoring decisions into a git-canonical project brain and cross-agent semantic recall bus.
          </p>
        </div>

        <!-- Card 4 -->
        <div class="rounded-xl border border-white/5 bg-slate-900/30 p-5 relative overflow-hidden group hover:border-indigo-500/10 transition-all">
          <div class="absolute top-0 right-0 p-3 font-mono text-4xl font-black text-white/5 group-hover:text-indigo-500/10 transition-colors">04</div>
          <span class="rounded bg-indigo-500/10 border border-indigo-500/20 px-2 py-0.5 font-mono text-[10px] text-indigo-300 font-semibold uppercase">04 / Improve</span>
          <h3 class="mt-4 text-base font-bold text-white">Compound quality</h3>
          <p class="mt-2 text-xs text-slate-400 leading-relaxed">
            Future runs retrieve the ledger's context automatically. Your agents get smarter with every commit, driving down defects and compile times.
          </p>
        </div>
      </div>
    </div>

    <!-- proof strip -->
    <div class="mt-20 border-t border-white/5 pt-8">
      <p class="text-xs font-medium tracking-wide text-slate-400 uppercase">
        Otta Observability metrics (SaaS delivery record — last 90 days)
      </p>
      <div class="mt-5 grid grid-cols-2 gap-x-6 gap-y-6 sm:grid-cols-3 lg:grid-cols-6">
        {
          proofMetrics.map(m => (
            <div>
              <div class="text-2xl font-bold sm:text-3xl">{m.value}</div>
              <div class="mt-1 text-xs font-semibold text-indigo-300">{m.label}</div>
              <div class="text-xs text-slate-500">{m.sub}</div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
