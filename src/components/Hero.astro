---
import { SITE } from "../config";
import { buildScenarios, proofMetrics, PULSE_STATUS_URL } from "../data/content";

const deliverySurfaces = [
  {
    step: "01",
    label: "Native workflows",
    title: "Claude Code + Codex",
    body: "Use deterministic Otta commands or skills without moving code into another editor.",
  },
  {
    step: "02",
    label: "Specialist stages",
    title: "Builder → DevOps",
    body: "Builder, reviewer, QA, and DevOps own different evidence and cannot collapse into self-approval.",
  },
  {
    step: "03",
    label: "GitHub spine",
    title: "Pulse enforcement",
    body: "Lifecycle events and gate verdicts keep acceptance, merge, release, and deploy state inspectable.",
  },
  {
    step: "04",
    label: "Reviewable learning",
    title: "Explicit LEARN receipts",
    body: "Promote durable lessons deliberately instead of silently rewriting the rules after a failure.",
  },
];
---

<section
  id="hero-spotlight"
  class="relative overflow-hidden border-b border-white/10 bg-[#07070b] pb-20 pt-20 text-white sm:pb-24 sm:pt-28 lg:pb-28 lg:pt-32"
>
  <div class="hero-grid pointer-events-none absolute inset-0 opacity-45"></div>
  <div class="hero-glow pointer-events-none absolute inset-0"></div>
  <div class="hero-orb hero-orb-left pointer-events-none absolute"></div>
  <div class="hero-orb hero-orb-right pointer-events-none absolute"></div>

  <div class="relative mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl text-center">
      <p class="otta-eyebrow">Harness-agnostic agent delivery control</p>
      <h1 class="text-gradient mt-5 text-5xl font-black tracking-[-0.055em] sm:text-7xl lg:text-[5.8rem] lg:leading-[0.94]">
        Let agents build.<br />Make delivery prove itself.
      </h1>
      <p class="mx-auto mt-7 max-w-3xl text-lg leading-relaxed text-zinc-300 sm:text-xl">
        Otta gives Claude Code and Codex a disciplined path from issue to verified
        release—with specialist review stages and Pulse-enforced GitHub evidence.
      </p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href="#get-started"
          class="rounded-xl bg-indigo-500 px-6 py-3.5 text-sm font-semibold text-white shadow-xl shadow-indigo-950/50 transition hover:-translate-y-0.5 hover:bg-indigo-400"
        >
          See how it works
        </a>
        <a
          href={SITE.bookingUrl}
          class="rounded-xl border border-white/15 bg-white/[0.035] px-6 py-3.5 text-sm font-semibold text-zinc-200 transition hover:border-white/30 hover:bg-white/[0.07]"
        >
          Book a walkthrough
        </a>
      </div>
    </div>

    <div
      class="mx-auto mt-16 max-w-5xl overflow-hidden rounded-3xl border border-indigo-300/15 bg-[#0c0c13]/94 shadow-[0_35px_120px_rgba(32,20,88,.42)] backdrop-blur sm:mt-20"
      data-scenario="gate-failure"
    >
      <div class="flex flex-col gap-4 border-b border-white/10 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <div class="flex items-center gap-3">
          <span class="flex gap-1.5" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-rose-400/70"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-amber-300/70"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/70"></span>
          </span>
          <span class="font-mono text-[11px] font-semibold tracking-[0.12em] text-zinc-400 uppercase">
            Otta delivery ledger
          </span>
        </div>
        <div class="flex flex-wrap gap-2" aria-label="Delivery scenarios">
          {
            buildScenarios.map((scenario, index) => (
              <button
                type="button"
                class="rounded-lg border border-white/10 px-3 py-2 text-xs font-semibold text-zinc-400 transition hover:border-indigo-300/30 hover:text-white aria-pressed:border-indigo-400/40 aria-pressed:bg-indigo-400/10 aria-pressed:text-indigo-200"
                data-scenario-control={scenario.key}
                aria-controls={`scenario-${scenario.key}`}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                {scenario.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="p-5 sm:p-7">
        {
          buildScenarios.map((scenario, index) => {
            const isDefault = index === 0;
            return (
              <section
                id={`scenario-${scenario.key}`}
                data-scenario-panel={scenario.key}
                hidden={!isDefault}
                aria-labelledby={`scenario-title-${scenario.key}`}
              >
                <div class="flex flex-col gap-3 border-b border-white/8 pb-5 sm:flex-row sm:items-center sm:justify-between">
                  <div>
                    <p class="font-mono text-[10px] tracking-[0.16em] text-zinc-500 uppercase">active delivery</p>
                    <h2 id={`scenario-title-${scenario.key}`} class="mt-1 text-base font-semibold text-zinc-100">
                      {scenario.issue}
                    </h2>
                  </div>
                  <span class="w-fit rounded-full border border-indigo-400/25 bg-indigo-400/10 px-3 py-1 font-mono text-[10px] font-bold tracking-wide text-indigo-200 uppercase">
                    {scenario.status}
                  </span>
                </div>
                <ol class="mt-5 grid gap-3 text-left">
                  {scenario.lines.map(([actor, line], lineIndex) => (
                    <li class="grid grid-cols-[1.25rem_5.5rem_1fr] items-start gap-2 font-mono text-xs leading-relaxed sm:grid-cols-[1.5rem_6.5rem_1fr] sm:text-sm">
                      <span class="text-zinc-600">{String(lineIndex + 1).padStart(2, "0")}</span>
                      <span class={actor === "pulse" ? "text-indigo-300" : "text-zinc-500"}>{actor}</span>
                      <span class={actor === "next" ? "text-emerald-300" : "text-zinc-300"}>{line}</span>
                    </li>
                  ))}
                </ol>
              </section>
            );
          })
        }
      </div>
    </div>

    <div class="mt-16 sm:mt-20">
      <div class="flex items-end justify-between gap-6 border-b border-white/10 pb-3">
        <p class="font-mono text-[10px] font-semibold tracking-[0.16em] text-zinc-500 uppercase">
          Delivery surfaces
        </p>
        <span class="hidden text-xs text-zinc-600 sm:block">local workflow → GitHub evidence</span>
      </div>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          deliverySurfaces.map(surface => (
            <article class="otta-card rounded-2xl p-5">
              <div class="flex items-center justify-between gap-3">
                <span class="font-mono text-[10px] font-bold text-indigo-300">{surface.step}</span>
                <span class="text-[10px] font-semibold tracking-wide text-zinc-500 uppercase">{surface.label}</span>
              </div>
              <h2 class="mt-5 text-base font-semibold text-white">{surface.title}</h2>
              <p class="mt-2 text-xs leading-relaxed text-zinc-400">{surface.body}</p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="mt-16 border-t border-white/10 pt-8 sm:mt-20">
      <p class="text-xs font-medium tracking-wide text-zinc-400 uppercase">
        Live from Otta Pulse — <a
          href="https://pulse.otta.build/status"
          class="underline decoration-dotted underline-offset-4 transition hover:text-zinc-200"
          rel="noopener">check it yourself</a
        >
      </p>
      <div class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
        {
          proofMetrics.map(metric => {
            const feature = metric.key === "pr_merged";
            const wide = feature || metric.key === "gate_verdict";
            return (
              <article
                class={[
                  "rounded-2xl border p-4 transition-colors sm:p-5",
                  wide ? "col-span-2" : "",
                  feature
                    ? "border-indigo-400/60 bg-gradient-to-br from-indigo-500 to-indigo-700 shadow-xl shadow-indigo-950/40"
                    : "border-white/10 bg-white/[0.025] hover:border-white/20",
                ].join(" ")}
              >
                <div
                  class="text-2xl font-bold tracking-tight text-white tabular-nums sm:text-3xl"
                  data-pulse-metric={metric.key}
                  data-pulse-unit={metric.unit ?? ""}
                >
                  {metric.fallback}
                </div>
                <div class={`mt-1 text-xs font-semibold ${feature ? "text-indigo-100" : "text-indigo-300"}`}>
                  {metric.label}
                </div>
                <div class={`text-xs ${feature ? "text-indigo-200/80" : "text-zinc-500"}`}>{metric.sub}</div>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ statusUrl: PULSE_STATUS_URL }}>
  (async () => {
    const tiles = document.querySelectorAll("[data-pulse-metric]");
    if (!tiles.length) return;

    let status;
    try {
      const res = await fetch(statusUrl, { signal: AbortSignal.timeout(4000) });
      if (!res.ok) return;
      status = await res.json();
    } catch {
      return;
    }

    const valueFor = key =>
      key === "repos" ? status.repos
      : key === "pr_cycle_p50_minutes" ? status.pr_cycle_p50_minutes
      : status.event_types?.[key];

    for (const el of tiles) {
      const raw = valueFor(el.dataset.pulseMetric);
      if (typeof raw !== "number" || !Number.isFinite(raw)) continue;
      el.textContent =
        el.dataset.pulseUnit === "min"
          ? `${raw < 10 ? Math.round(raw * 10) / 10 : Math.round(raw)} min`
          : raw.toLocaleString("en-US");
    }
  })();
</script>

<script>
  const scenarioShell = document.querySelector<HTMLElement>("[data-scenario]");
  const controls = document.querySelectorAll<HTMLButtonElement>("[data-scenario-control]");
  const panels = document.querySelectorAll<HTMLElement>("[data-scenario-panel]");

  for (const control of controls) {
    control.addEventListener("click", () => {
      const key = control.dataset.scenarioControl;
      if (!key) return;

      scenarioShell?.setAttribute("data-scenario", key);
      for (const candidate of controls) {
        candidate.setAttribute("aria-pressed", String(candidate === control));
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.scenarioPanel !== key;
      }
    });
  }

  const hero = document.getElementById("hero-spotlight");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (hero && !reducedMotion.matches) {
    hero.addEventListener("pointermove", event => {
      const rect = hero.getBoundingClientRect();
      hero.style.setProperty("--mouse-x", `${event.clientX - rect.left}px`);
      hero.style.setProperty("--mouse-y", `${event.clientY - rect.top}px`);
    });
  }
</script>

<style>
  .hero-grid {
    background-image:
      linear-gradient(rgba(139, 124, 255, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(139, 124, 255, 0.055) 1px, transparent 1px);
    background-size: 52px 52px;
    mask-image: linear-gradient(to bottom, black, transparent 72%);
  }

  .hero-glow {
    background: radial-gradient(700px circle at var(--mouse-x, 50%) var(--mouse-y, 20%), rgba(111, 88, 255, 0.18), transparent 72%);
  }

  .hero-orb {
    width: 28rem;
    height: 28rem;
    border-radius: 999px;
    filter: blur(90px);
    opacity: 0.17;
    animation: orb-drift 12s ease-in-out infinite alternate;
  }

  .hero-orb-left {
    left: -16rem;
    top: 8rem;
    background: #6e56ff;
  }

  .hero-orb-right {
    right: -18rem;
    top: 22rem;
    background: #9d4edd;
    animation-delay: -5s;
  }

  @keyframes orb-drift {
    to { transform: translate3d(2rem, 1.5rem, 0) scale(1.08); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-orb { animation: none; }
  }
</style>
