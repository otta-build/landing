---
import { BRAND, SITE } from "../config";
import { proofMetrics } from "../data/content";
---

<section id="hero-spotlight" class="relative overflow-hidden bg-zinc-950 text-white">

  <!-- Animated gradient orbs -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="hero-orb hero-orb-1 absolute -top-60 left-[20%] h-[700px] w-[700px] rounded-full bg-indigo-600/[0.18] blur-[140px]"></div>
    <div class="hero-orb hero-orb-2 absolute top-40 right-[10%] h-[500px] w-[500px] rounded-full bg-violet-700/[0.12] blur-[120px]"></div>
    <div class="hero-orb hero-orb-3 absolute bottom-0 left-[40%] h-[400px] w-[400px] rounded-full bg-indigo-500/[0.08] blur-[100px]"></div>
  </div>

  <!-- Dot grid -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.035]"
    style="background-image: radial-gradient(circle, rgba(99,102,241,0.8) 1px, transparent 1px); background-size: 32px 32px;"
    aria-hidden="true"
  ></div>

  <!-- ─── HERO COPY ─── -->
  <div class="relative mx-auto w-full max-w-4xl px-4 pt-24 pb-12 text-center sm:px-6 sm:pt-32 lg:pt-40">

    <!-- Status badge -->
    <div class="hero-reveal inline-flex items-center gap-2 rounded-full border border-indigo-500/25 bg-indigo-500/10 px-4 py-1.5 mb-8">
      <span class="h-1.5 w-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
      <span class="text-xs font-semibold text-indigo-300 tracking-wide">Plugin free · Cockpit in early access</span>
    </div>

    <!-- Main headline -->
    <h1 class="hero-reveal hero-reveal-d1 text-5xl font-black tracking-tight leading-[0.92] sm:text-6xl lg:text-[5.5rem] mb-6">
      The self-learning<br>
      <span class="gradient-heading">AI software factory.</span>
    </h1>

    <p class="hero-reveal hero-reveal-d2 mx-auto max-w-2xl text-lg text-zinc-400 leading-relaxed mb-10">
      Otta turns vibe coding into a structured, self-improving production pipeline — adaptive quality gates, persistent memory, and a flywheel that gets smarter after every build.
    </p>

    <!-- Install box -->
    <div class="hero-reveal hero-reveal-d3 mx-auto max-w-md mb-8">
      <div class="rounded-xl border border-zinc-800 bg-zinc-900/80 backdrop-blur-sm overflow-hidden shadow-xl shadow-black/40">
        <div class="flex border-b border-zinc-800 text-xs font-semibold">
          <button data-tab="plugin" class="install-tab install-tab-active flex-1 px-4 py-2.5 transition-colors">
            Claude Code Plugin
          </button>
          <button data-tab="cockpit" class="install-tab flex-1 px-4 py-2.5 text-zinc-500 hover:text-zinc-200 transition-colors">
            Cockpit App
          </button>
        </div>
        <div id="install-panel-plugin" class="install-panel p-4 font-mono text-sm text-left">
          <div class="text-zinc-600 text-xs mb-2.5"># 3 commands · free · runs in Claude Code</div>
          <div class="space-y-1">
            <div><span class="text-indigo-400 select-none">$ </span><span class="text-zinc-100">/plugin marketplace add otta-build/plugin</span></div>
            <div><span class="text-indigo-400 select-none">$ </span><span class="text-zinc-100">/plugin install otta</span></div>
            <div><span class="text-indigo-400 select-none">$ </span><span class="text-zinc-100">/otta:setup</span></div>
          </div>
        </div>
        <div id="install-panel-cockpit" class="install-panel hidden p-4 text-left">
          <p class="text-sm text-zinc-400 leading-relaxed">Full autonomous pipeline UI — issue management, live run timelines, and agent gate approvals in a native desktop app.</p>
          <a href="#waitlist" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-400 hover:text-indigo-300 transition-colors">
            Request early access
            <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- CTAs -->
    <div class="hero-reveal hero-reveal-d4 flex flex-col items-center gap-3 sm:flex-row sm:justify-center mb-12">
      <a
        href="#get-started"
        class="rounded-lg bg-indigo-600 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-600/30 transition-all hover:bg-indigo-500 hover:scale-[1.02] hover:shadow-indigo-500/40"
      >
        Get started
      </a>
      <a
        href={SITE.bookingUrl}
        class="rounded-lg border border-zinc-700/80 px-7 py-3 text-sm font-semibold text-zinc-300 transition-colors hover:border-zinc-500 hover:text-white"
      >
        Book a walkthrough
      </a>
    </div>

    <!-- Inline proof strip -->
    <div class="hero-reveal hero-reveal-d4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-zinc-600">
      <span><span class="font-mono font-bold text-zinc-300">457</span> PRs merged · 90 days</span>
      <span class="text-zinc-800">·</span>
      <span><span class="font-mono font-bold text-zinc-300">7 min</span> median PR cycle</span>
      <span class="text-zinc-800">·</span>
      <span><span class="font-mono font-bold text-zinc-300">6 / 3</span> blockers caught on CI-green PRs</span>
    </div>
  </div>

  <!-- ─── LIVE TERMINAL ─── -->
  <div class="hero-reveal hero-reveal-d5 relative mx-auto w-full max-w-3xl px-4 pb-16 sm:px-6">
    <div class="rounded-2xl border border-zinc-800/60 bg-black/60 backdrop-blur-sm overflow-hidden shadow-2xl shadow-black/60">
      <div class="flex items-center justify-between border-b border-zinc-900 px-5 py-3">
        <div class="flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
          <span class="ml-3 font-mono text-[11px] text-zinc-600">otta · factory gate loop</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
          <span class="font-mono text-[10px] text-zinc-600 tracking-widest uppercase">live</span>
        </div>
      </div>
      <div id="terminal-screen" class="font-mono text-[11px] leading-relaxed px-5 py-4 min-h-[180px] max-h-[180px] overflow-hidden text-zinc-400 space-y-2">
        <div class="text-zinc-700">// Initializing live controller feed...</div>
      </div>
    </div>
  </div>

  <!-- ─── ARCHITECTURE CARDS ─── -->
  <div class="relative mx-auto w-full max-w-7xl px-4 pb-16 sm:px-6">
    <div class="text-[10px] font-bold tracking-[0.2em] text-zinc-700 uppercase border-b border-zinc-900 pb-3 mb-6">
      // CORE ARCHITECTURE
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { num: "01", tag: "Rules Layer", title: "Global standing orders", body: "Team-wide constraints, strict typechecks, test-first TDD. Prompts drift, rules don't." },
        { num: "02", tag: "Orchestration", title: "Multi-agent coordination", body: "Breaks goals into subtasks, delegates to parallel executors — Claude Code, Codex, or custom." },
        { num: "03", tag: "Memory Layer", title: "Short & persistent memory", body: "Git-canonical project brain + cross-agent recall. Agents never forget context or repeat dead ends." },
        { num: "04", tag: "Execution & MCP", title: "Secure gateway", body: "Role-based tool access — terminals, filesystems, web via MCP — preventing destructive unvalidated runs." },
      ].map(c => (
        <div class="group relative rounded-xl border border-zinc-900 bg-zinc-950 p-5 overflow-hidden transition-all duration-300 hover:border-indigo-500/20 hover:bg-zinc-900/60 hover:-translate-y-0.5">
          <div class="absolute top-3 right-4 font-mono text-5xl font-black text-white/[0.035] group-hover:text-indigo-500/[0.07] transition-colors select-none">{c.num}</div>
          <span class="inline-block rounded bg-indigo-600/10 border border-indigo-500/20 px-2 py-0.5 font-mono text-[9px] font-bold uppercase tracking-widest text-indigo-400">{c.tag}</span>
          <h3 class="mt-4 text-sm font-bold text-white">{c.title}</h3>
          <p class="mt-1.5 text-[11px] text-zinc-600 leading-relaxed">{c.body}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- ─── METRICS STRIP ─── -->
  <div class="relative mx-auto w-full max-w-7xl px-4 pb-20 sm:px-6">
    <div class="border-t border-zinc-900 pt-10">
      <p class="text-[10px] font-bold tracking-[0.2em] text-zinc-700 uppercase mb-7">
        Otta observability metrics · last 90 days
      </p>
      <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-6">
        {proofMetrics.map(m => (
          <div>
            <div class="text-2xl font-black font-mono text-white sm:text-3xl">{m.value}</div>
            <div class="mt-1 text-xs font-semibold text-indigo-400">{m.label}</div>
            <div class="text-[11px] text-zinc-700">{m.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

</section>

<style>
  /* Gradient headline */
  .gradient-heading {
    background: linear-gradient(135deg, #818cf8 0%, #a78bfa 40%, #c084fc 70%, #e879f9 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Orb drift animation */
  @keyframes orb-drift-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(60px, -40px) scale(1.08); }
    66% { transform: translate(-30px, 50px) scale(0.95); }
  }
  @keyframes orb-drift-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    40% { transform: translate(-50px, 30px) scale(1.05); }
    70% { transform: translate(40px, -60px) scale(0.97); }
  }
  @keyframes orb-drift-3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, -30px) scale(1.1); }
  }
  .hero-orb-1 { animation: orb-drift-1 18s ease-in-out infinite; }
  .hero-orb-2 { animation: orb-drift-2 22s ease-in-out infinite; }
  .hero-orb-3 { animation: orb-drift-3 15s ease-in-out infinite; }

  /* Reveal animations */
  .hero-reveal {
    opacity: 0;
    transform: translateY(20px);
    animation: hero-fade-up 0.7s ease-out forwards;
  }
  .hero-reveal-d1 { animation-delay: 0.1s; }
  .hero-reveal-d2 { animation-delay: 0.2s; }
  .hero-reveal-d3 { animation-delay: 0.32s; }
  .hero-reveal-d4 { animation-delay: 0.44s; }
  .hero-reveal-d5 { animation-delay: 0.56s; }
  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Active tab */
  .install-tab-active {
    color: white;
    background: rgba(99, 102, 241, 0.12);
    border-bottom: 1px solid rgba(99, 102, 241, 0.4);
  }
</style>

<script>
  // ── Tab switcher ──
  const tabs = document.querySelectorAll<HTMLButtonElement>(".install-tab");
  const panels = document.querySelectorAll<HTMLElement>(".install-panel");
  tabs.forEach(tab => {
    tab.addEventListener("click", () => {
      const target = tab.dataset.tab;
      tabs.forEach(t => {
        t.classList.toggle("install-tab-active", t.dataset.tab === target);
        t.classList.toggle("text-zinc-500", t.dataset.tab !== target);
        t.style.borderBottom = t.dataset.tab === target ? "1px solid rgba(99,102,241,0.4)" : "";
      });
      panels.forEach(p => {
        p.classList.toggle("hidden", !p.id.endsWith(target ?? ""));
      });
    });
  });

  // ── Terminal animation ──
  interface TermLine { text: string; cls: string; typewriter?: boolean; delay?: number; }

  const LOG: TermLine[] = [
    { text: 'Triggered via GitHub App: "implement-metrics" (slot #4)', cls: "text-white", typewriter: true, delay: 1400 },
    { text: "// Creating parallel isolated worktree on slot #4", cls: "text-zinc-600", delay: 700 },
    { text: "├─ Fetching project context... OK", cls: "text-zinc-500", delay: 550 },
    { text: "└─ Spawning claude-code executor... ACTIVE", cls: "text-zinc-500", delay: 750 },
    { text: "// Enforcing merge-blocking gates", cls: "text-zinc-600", delay: 700 },
    { text: "├─ Running strict typecheck... PASS", cls: "text-zinc-500", delay: 650 },
    { text: "✕ FAIL: test_ledger_total (Expected 457, got null)", cls: "text-rose-400 font-semibold", delay: 950 },
    { text: "↻ Self-correcting — regenerating fix...", cls: "text-amber-400 font-semibold", delay: 1700 },
    { text: "// Re-running test-first validation", cls: "text-zinc-600", delay: 750 },
    { text: "✓ PASS: test_ledger_total (100% test-driven)", cls: "text-indigo-400 font-semibold", delay: 850 },
    { text: "├─ Visual capture (desktop+mobile)... 8 shots verified", cls: "text-zinc-500", delay: 750 },
    { text: "★ All gates green. Merged Pull Request #210!", cls: "text-indigo-300 font-bold", delay: 3800 },
  ];

  const screen = document.getElementById("terminal-screen");

  function typeStr(el: HTMLElement, str: string, i: number, cb: () => void) {
    if (i < str.length) {
      el.textContent += str[i];
      setTimeout(() => typeStr(el, str, i + 1, cb), 25);
    } else {
      cb();
    }
  }

  function renderLine(idx: number) {
    if (!screen) return;
    if (idx >= LOG.length) {
      setTimeout(() => { screen.innerHTML = ""; renderLine(0); }, 3200);
      return;
    }
    const cur = LOG[idx];
    const row = document.createElement("div");
    row.className = cur.cls + " opacity-0 transition-opacity duration-200";
    screen.appendChild(row);
    requestAnimationFrame(() => row.classList.remove("opacity-0"));

    if (cur.typewriter) {
      const arrow = document.createElement("span");
      arrow.className = "text-indigo-400 font-bold mr-2";
      arrow.textContent = "→";
      row.appendChild(arrow);
      const span = document.createElement("span");
      row.appendChild(span);
      typeStr(span, cur.text, 0, () => {
        setTimeout(() => renderLine(idx + 1), cur.delay ?? 1000);
      });
    } else {
      row.textContent = cur.text;
      screen.scrollTop = screen.scrollHeight;
      setTimeout(() => renderLine(idx + 1), cur.delay ?? 1000);
    }
  }

  if (screen) { screen.innerHTML = ""; renderLine(0); }
</script>
