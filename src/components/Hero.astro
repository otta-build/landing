---
import { BRAND, SITE } from "../config";
import { proofMetrics } from "../data/content";
---

<section id="hero-spotlight" class="relative overflow-hidden bg-zinc-950 text-white">

  <!-- Animated gradient orbs -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="hero-orb hero-orb-1 absolute -top-60 left-[20%] h-[700px] w-[700px] rounded-full bg-indigo-600/[0.18] blur-[140px]"></div>
    <div class="hero-orb hero-orb-2 absolute top-40 right-[10%] h-[500px] w-[500px] rounded-full bg-violet-700/[0.12] blur-[120px]"></div>
    <div class="hero-orb hero-orb-3 absolute bottom-0 left-[40%] h-[400px] w-[400px] rounded-full bg-indigo-500/[0.08] blur-[100px]"></div>
  </div>

  <!-- Dot grid -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.035]"
    style="background-image: radial-gradient(circle, rgba(99,102,241,0.8) 1px, transparent 1px); background-size: 32px 32px;"
    aria-hidden="true"
  ></div>

  <!-- ─── HERO COPY ─── -->
  <div class="relative mx-auto w-full max-w-4xl px-4 pt-24 pb-12 text-center sm:px-6 sm:pt-32 lg:pt-40">

    <!-- Status badge -->
    <div class="hero-reveal inline-flex items-center gap-2 rounded-full border border-indigo-500/25 bg-indigo-500/10 px-4 py-1.5 mb-8">
      <span class="h-1.5 w-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
      <span class="text-xs font-semibold text-indigo-300 tracking-wide">Plugin free · Cockpit in early access</span>
    </div>

    <!-- Main headline -->
    <h1 class="hero-reveal hero-reveal-d1 text-5xl font-black tracking-tight leading-[0.92] sm:text-6xl lg:text-[5.5rem] mb-6">
      The self-learning<br>
      <span class="gradient-heading">AI software factory.</span>
    </h1>

    <p class="hero-reveal hero-reveal-d2 mx-auto max-w-2xl text-lg text-zinc-400 leading-relaxed mb-10">
      Otta turns vibe coding into a structured, self-improving production pipeline — adaptive quality gates, persistent memory, and a flywheel that gets smarter after every build.
    </p>

    <!-- Install box -->
    <div class="hero-reveal hero-reveal-d3 mx-auto max-w-md mb-8">
      <div class="rounded-xl border border-zinc-800 bg-zinc-900/80 backdrop-blur-sm overflow-hidden shadow-xl shadow-black/40">
        <div class="flex border-b border-zinc-800 text-xs font-semibold">
          <button data-tab="plugin" class="install-tab install-tab-active flex-1 px-4 py-2.5 transition-colors">
            Claude Code Plugin
          </button>
          <button data-tab="cockpit" class="install-tab flex-1 px-4 py-2.5 text-zinc-500 hover:text-zinc-200 transition-colors">
            Cockpit App
          </button>
        </div>
        <div id="install-panel-plugin" class="install-panel p-4 font-mono text-sm text-left">
          <div class="text-zinc-600 text-xs mb-2.5"># 3 commands · free · runs in Claude Code</div>
          <div class="space-y-1">
            <div><span class="text-indigo-400 select-none">$ </span><span class="text-zinc-100">/plugin marketplace add otta-build/plugin</span></div>
            <div><span class="text-indigo-400 select-none">$ </span><span class="text-zinc-100">/plugin install otta</span></div>
            <div><span class="text-indigo-400 select-none">$ </span><span class="text-zinc-100">/otta:setup</span></div>
          </div>
        </div>
        <div id="install-panel-cockpit" class="install-panel hidden p-4 text-left">
          <p class="text-sm text-zinc-400 leading-relaxed">Full autonomous pipeline UI — issue management, live run timelines, and agent gate approvals in a native desktop app.</p>
          <a href="#waitlist" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-400 hover:text-indigo-300 transition-colors">
            Request early access
            <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- CTAs -->
    <div class="hero-reveal hero-reveal-d4 flex flex-col items-center gap-3 sm:flex-row sm:justify-center mb-12">
      <a
        href="#get-started"
        class="rounded-lg bg-indigo-600 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-600/30 transition-all hover:bg-indigo-500 hover:scale-[1.02] hover:shadow-indigo-500/40"
      >
        Get started
      </a>
      <a
        href={SITE.bookingUrl}
        class="rounded-lg border border-zinc-700/80 px-7 py-3 text-sm font-semibold text-zinc-300 transition-colors hover:border-zinc-500 hover:text-white"
      >
        Book a walkthrough
      </a>
    </div>
  </div>

  <!-- ─── PIPELINE VISUALIZER ─── -->
  <div class="hero-reveal hero-reveal-d5 relative mx-auto w-full max-w-5xl px-4 pb-16 sm:px-6">
    <div class="rounded-2xl border border-zinc-800/60 bg-black/70 backdrop-blur-sm overflow-hidden shadow-2xl shadow-black/60">

      <!-- Window chrome -->
      <div class="flex items-center justify-between border-b border-zinc-900 px-5 py-3">
        <div class="flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-zinc-700/80"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-zinc-700/80"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-zinc-700/80"></span>
          <span class="ml-3 font-mono text-[11px] text-zinc-600">otta · pipeline · <span id="pipe-issue-label" class="text-zinc-500">"ship-analytics-dashboard" #47</span></span>
        </div>
        <div class="flex items-center gap-3">
          <span id="pipe-slot" class="font-mono text-[10px] text-zinc-700">slot-02</span>
          <span class="flex items-center gap-1">
            <span class="h-1.5 w-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
            <span class="font-mono text-[10px] text-zinc-600 tracking-widest uppercase">live</span>
          </span>
        </div>
      </div>

      <!-- Stage headers -->
      <div class="grid grid-cols-4 border-b border-zinc-900">
        {["builder", "reviewer", "qa", "devops"].map((name, i) => (
          <div id={`stage-${name}`} class={`stage-header border-zinc-900 px-3 py-2.5 ${i < 3 ? "border-r" : ""}`}>
            <div class="font-mono text-[9px] text-zinc-700 tracking-widest uppercase mb-1">0{i + 1}</div>
            <div class="font-mono text-[11px] font-bold text-zinc-500">otta:{name}</div>
            <div id={`stage-${name}-badge`} class="stage-badge mt-1.5 inline-flex items-center gap-1 rounded px-1.5 py-0.5 font-mono text-[9px] font-bold uppercase tracking-wider waiting-badge">
              <span class="stage-dot h-1 w-1 rounded-full bg-zinc-700"></span>
              <span class="stage-label">waiting</span>
            </div>
            <div id={`stage-${name}-time`} class="stage-time mt-1 font-mono text-[9px] text-zinc-700 h-3"></div>
          </div>
        ))}
      </div>

      <!-- Log output -->
      <div id="pipeline-log" class="font-mono text-[11px] leading-relaxed px-5 py-4 min-h-[160px] max-h-[160px] overflow-hidden text-zinc-400 space-y-1.5">
        <div class="text-zinc-700">// Waiting for next issue...</div>
      </div>

      <!-- Footer bar -->
      <div class="flex items-center justify-between border-t border-zinc-900 px-5 py-2.5 text-[10px] font-mono">
        <div class="flex items-center gap-4 text-zinc-700">
          <span>OTTA PULSE <span class="text-zinc-600">v1.1</span></span>
          <span id="pipe-cost" class="text-zinc-700">$0.00</span>
        </div>
        <div id="pipe-status-bar" class="text-zinc-700">IDLE</div>
      </div>

    </div>
  </div>

  <!-- ─── ARCHITECTURE CARDS ─── -->
  <div class="relative mx-auto w-full max-w-7xl px-4 pb-16 sm:px-6">
    <div class="text-[10px] font-bold tracking-[0.2em] text-zinc-700 uppercase border-b border-zinc-900 pb-3 mb-6">
      // CORE ARCHITECTURE
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { num: "01", tag: "Rules Layer", title: "Global standing orders", body: "Team-wide constraints, strict typechecks, test-first TDD. Prompts drift, rules don't." },
        { num: "02", tag: "Orchestration", title: "Multi-agent pipeline", body: "builder → reviewer → qa → devops. Each agent is specialized; none self-approve." },
        { num: "03", tag: "Memory Layer", title: "Short & persistent memory", body: "Git-canonical brain + cross-agent recall via mem0. Agents never repeat dead ends." },
        { num: "04", tag: "GEPA Flywheel", title: "Self-learning optimizer", body: "Rich pipeline verdicts feed GEPA. Prompts improve from outcomes — 35× more sample-efficient than RL." },
      ].map(c => (
        <div class="group relative rounded-xl border border-zinc-900 bg-zinc-950 p-5 overflow-hidden transition-all duration-300 hover:border-indigo-500/20 hover:bg-zinc-900/60 hover:-translate-y-0.5">
          <div class="absolute top-3 right-4 font-mono text-5xl font-black text-white/[0.035] group-hover:text-indigo-500/[0.07] transition-colors select-none">{c.num}</div>
          <span class="inline-block rounded bg-indigo-600/10 border border-indigo-500/20 px-2 py-0.5 font-mono text-[9px] font-bold uppercase tracking-widest text-indigo-400">{c.tag}</span>
          <h3 class="mt-4 text-sm font-bold text-white">{c.title}</h3>
          <p class="mt-1.5 text-[11px] text-zinc-600 leading-relaxed">{c.body}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- ─── METRICS STRIP ─── -->
  <div class="relative mx-auto w-full max-w-7xl px-4 pb-20 sm:px-6">
    <div class="border-t border-zinc-900 pt-10">
      <p class="text-[10px] font-bold tracking-[0.2em] text-zinc-700 uppercase mb-7">
        Otta observability metrics · last 90 days
      </p>
      <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-6">
        {proofMetrics.map(m => (
          <div>
            <div class="text-2xl font-black font-mono text-white sm:text-3xl">{m.value}</div>
            <div class="mt-1 text-xs font-semibold text-indigo-400">{m.label}</div>
            <div class="text-[11px] text-zinc-700">{m.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

</section>

<style>
  .gradient-heading {
    background: linear-gradient(135deg, #818cf8 0%, #a78bfa 40%, #c084fc 70%, #e879f9 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @keyframes orb-drift-1 {
    0%, 100% { transform: translate(0,0) scale(1); }
    33% { transform: translate(60px,-40px) scale(1.08); }
    66% { transform: translate(-30px,50px) scale(0.95); }
  }
  @keyframes orb-drift-2 {
    0%, 100% { transform: translate(0,0) scale(1); }
    40% { transform: translate(-50px,30px) scale(1.05); }
    70% { transform: translate(40px,-60px) scale(0.97); }
  }
  @keyframes orb-drift-3 {
    0%, 100% { transform: translate(0,0) scale(1); }
    50% { transform: translate(30px,-30px) scale(1.1); }
  }
  .hero-orb-1 { animation: orb-drift-1 18s ease-in-out infinite; }
  .hero-orb-2 { animation: orb-drift-2 22s ease-in-out infinite; }
  .hero-orb-3 { animation: orb-drift-3 15s ease-in-out infinite; }

  .hero-reveal {
    opacity: 0;
    transform: translateY(20px);
    animation: hero-fade-up 0.7s ease-out forwards;
  }
  .hero-reveal-d1 { animation-delay: 0.1s; }
  .hero-reveal-d2 { animation-delay: 0.2s; }
  .hero-reveal-d3 { animation-delay: 0.32s; }
  .hero-reveal-d4 { animation-delay: 0.44s; }
  .hero-reveal-d5 { animation-delay: 0.56s; }
  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .install-tab-active {
    color: white;
    background: rgba(99,102,241,0.12);
    border-bottom: 1px solid rgba(99,102,241,0.4);
  }

  /* Stage badge states */
  .waiting-badge  { background: rgba(255,255,255,0.04); color: #52525b; }
  .active-badge   { background: rgba(99,102,241,0.15); color: #a5b4fc; border: 1px solid rgba(99,102,241,0.3); }
  .pass-badge     { background: rgba(52,211,153,0.1);  color: #6ee7b7; border: 1px solid rgba(52,211,153,0.25); }
  .fail-badge     { background: rgba(248,113,113,0.1); color: #fca5a5; border: 1px solid rgba(248,113,113,0.25); }

  .active-badge .stage-dot { background: #818cf8; animation: pulse 1s ease-in-out infinite; }
  .pass-badge   .stage-dot { background: #6ee7b7; }
  .fail-badge   .stage-dot { background: #fca5a5; }
  @keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:0.4;} }

  .stage-header.stage-active  { background: rgba(99,102,241,0.04); }
  .stage-header.stage-done    { background: rgba(52,211,153,0.03); }
</style>

<script>
  // ── Tab switcher ──
  document.querySelectorAll<HTMLButtonElement>(".install-tab").forEach(tab => {
    tab.addEventListener("click", () => {
      const target = tab.dataset.tab;
      document.querySelectorAll<HTMLButtonElement>(".install-tab").forEach(t => {
        const on = t.dataset.tab === target;
        t.classList.toggle("install-tab-active", on);
        t.classList.toggle("text-zinc-500", !on);
        (t as any).style.borderBottom = on ? "1px solid rgba(99,102,241,0.4)" : "";
      });
      document.querySelectorAll<HTMLElement>(".install-panel").forEach(p => {
        p.classList.toggle("hidden", !p.id.endsWith(target ?? ""));
      });
    });
  });

  // ── Pipeline animation ──
  interface PipelineRun {
    issue: string;
    slot: string;
    stages: StageScript[];
  }
  interface StageScript {
    name: string;
    duration: number; // ms before passing to next
    lines: { text: string; cls?: string; delay: number }[];
    failLine?: { text: string; cls?: string; delay: number };
    passes: boolean;
  }

  const RUNS: PipelineRun[] = [
    {
      issue: '"add-analytics-dashboard" #47',
      slot: "slot-02",
      stages: [
        {
          name: "builder",
          duration: 9000,
          passes: true,
          lines: [
            { text: "→ session context loaded from brain (247 rules)", cls: "text-zinc-500", delay: 400 },
            { text: "→ created isolated worktree on slot-02", cls: "text-zinc-500", delay: 700 },
            { text: "→ spawning claude-code executor...", cls: "text-zinc-500", delay: 600 },
            { text: "  writing failing test: test_dashboard_render", cls: "text-zinc-600", delay: 900 },
            { text: "✕ FAIL test_dashboard_render (component undefined)", cls: "text-rose-400 font-semibold", delay: 1000 },
            { text: "  implementing AnalyticsDashboard component...", cls: "text-zinc-500", delay: 1400 },
            { text: "✓ PASS test_dashboard_render", cls: "text-emerald-400", delay: 900 },
            { text: "  typecheck: strict mode... PASS", cls: "text-zinc-500", delay: 700 },
            { text: "  preflight gate: platform-health... PASS", cls: "text-zinc-500", delay: 700 },
            { text: "→ handing off to otta:reviewer", cls: "text-indigo-400 font-semibold", delay: 500 },
          ],
        },
        {
          name: "reviewer",
          duration: 6500,
          passes: true,
          lines: [
            { text: "→ loading spec for issue #47...", cls: "text-zinc-500", delay: 400 },
            { text: "  AC1: dashboard renders /metrics route ✓", cls: "text-zinc-500", delay: 700 },
            { text: "  AC2: token spend visible per run ✓", cls: "text-zinc-500", delay: 700 },
            { text: "  AC3: mobile breakpoint ≥ 375px ✓", cls: "text-zinc-500", delay: 700 },
            { text: "  AC4: no regressions in existing routes ✓", cls: "text-zinc-500", delay: 700 },
            { text: "  scope: surgical — 3 files touched, 0 unrelated", cls: "text-zinc-600", delay: 600 },
            { text: "→ spec compliance: PASS — handing to otta:qa", cls: "text-indigo-400 font-semibold", delay: 600 },
          ],
        },
        {
          name: "qa",
          duration: 5500,
          passes: true,
          lines: [
            { text: "→ adversarially verifying each AC...", cls: "text-zinc-500", delay: 400 },
            { text: "  AC1 verified: dashboard route returns 200 ✓", cls: "text-zinc-500", delay: 700 },
            { text: "  AC2 verified: cost_events envelope present ✓", cls: "text-zinc-500", delay: 700 },
            { text: "  AC3 verified: viewport 375 snapshot captured ✓", cls: "text-zinc-500", delay: 800 },
            { text: "  visual diff: 4 desktop + 4 mobile screenshots ✓", cls: "text-zinc-500", delay: 700 },
            { text: "→ gate: PASS — handing to otta:devops", cls: "text-indigo-400 font-semibold", delay: 600 },
          ],
        },
        {
          name: "devops",
          duration: 5000,
          passes: true,
          lines: [
            { text: "→ opening PR #48 with seeded .pr-body.md", cls: "text-zinc-500", delay: 400 },
            { text: "  Otta Pulse GitHub App: checks registered", cls: "text-zinc-500", delay: 600 },
            { text: "  acceptance-gate: ✓  coverage-gate: ✓", cls: "text-emerald-400", delay: 800 },
            { text: "  visual-gate: ✓  typecheck-gate: ✓", cls: "text-emerald-400", delay: 700 },
            { text: "★ PR #48 merged · Pulse telemetry logged", cls: "text-indigo-300 font-bold", delay: 1000 },
            { text: "  flywheel: run verdict stored → GEPA ledger", cls: "text-zinc-600", delay: 700 },
          ],
        },
      ],
    },
    {
      issue: '"fix-auth-token-expiry" #52',
      slot: "slot-01",
      stages: [
        {
          name: "builder",
          duration: 7000,
          passes: true,
          lines: [
            { text: "→ brain recalled: 'token expiry check ≤ not <' (3 prior fixes)", cls: "text-amber-400", delay: 400 },
            { text: "→ created worktree on slot-01", cls: "text-zinc-500", delay: 600 },
            { text: "  writing failing test: test_token_expiry_boundary", cls: "text-zinc-600", delay: 800 },
            { text: "✕ FAIL test_token_expiry_boundary (off-by-one)", cls: "text-rose-400 font-semibold", delay: 900 },
            { text: "  applying fix: < → <= in auth/middleware.ts:88", cls: "text-zinc-500", delay: 1200 },
            { text: "✓ PASS test_token_expiry_boundary", cls: "text-emerald-400", delay: 800 },
            { text: "→ handing off to otta:reviewer", cls: "text-indigo-400 font-semibold", delay: 500 },
          ],
        },
        {
          name: "reviewer",
          duration: 5000,
          passes: true,
          lines: [
            { text: "  AC1: boundary case test present ✓", cls: "text-zinc-500", delay: 600 },
            { text: "  AC2: no other auth logic changed ✓", cls: "text-zinc-500", delay: 700 },
            { text: "  surgical: 1 file, 1 line — no scope creep ✓", cls: "text-zinc-500", delay: 700 },
            { text: "→ spec compliance: PASS — handing to otta:qa", cls: "text-indigo-400 font-semibold", delay: 600 },
          ],
        },
        {
          name: "qa",
          duration: 4500,
          passes: true,
          lines: [
            { text: "  adversarial: tried to break boundary... holds ✓", cls: "text-zinc-500", delay: 600 },
            { text: "  regression: all 47 existing auth tests PASS ✓", cls: "text-zinc-500", delay: 800 },
            { text: "→ gate: PASS — handing to otta:devops", cls: "text-indigo-400 font-semibold", delay: 600 },
          ],
        },
        {
          name: "devops",
          duration: 4000,
          passes: true,
          lines: [
            { text: "→ PR #53 opened · all Pulse checks green", cls: "text-zinc-500", delay: 400 },
            { text: "  GEPA: verdict logged — 'token boundary fix'", cls: "text-zinc-600", delay: 700 },
            { text: "  flywheel: brain updated — guard promoted to preflight", cls: "text-amber-400", delay: 900 },
            { text: "★ PR #53 merged · $/PR: $0.18", cls: "text-indigo-300 font-bold", delay: 1000 },
          ],
        },
      ],
    },
  ];

  const log = document.getElementById("pipeline-log")!;
  const issueLabel = document.getElementById("pipe-issue-label")!;
  const slotLabel = document.getElementById("pipe-slot")!;
  const costEl = document.getElementById("pipe-cost")!;
  const statusBar = document.getElementById("pipe-status-bar")!;

  const STAGES = ["builder", "reviewer", "qa", "devops"];

  function getBadge(name: string) { return document.getElementById(`stage-${name}-badge`); }
  function getTime(name: string)  { return document.getElementById(`stage-${name}-time`); }
  function getHeader(name: string){ return document.getElementById(`stage-${name}`); }

  function setBadge(name: string, state: "waiting"|"active"|"pass"|"fail", label: string) {
    const b = getBadge(name); if (!b) return;
    b.className = `stage-badge mt-1.5 inline-flex items-center gap-1 rounded px-1.5 py-0.5 font-mono text-[9px] font-bold uppercase tracking-wider ${state}-badge`;
    const dot = b.querySelector(".stage-dot") as HTMLElement;
    const lbl = b.querySelector(".stage-label") as HTMLElement;
    if (dot) dot.className = `stage-dot h-1 w-1 rounded-full ${state === "active" ? "bg-[#818cf8]" : state === "pass" ? "bg-[#6ee7b7]" : state === "fail" ? "bg-[#fca5a5]" : "bg-zinc-700"}`;
    if (lbl) lbl.textContent = label;
  }

  function resetRun() {
    log.innerHTML = "";
    STAGES.forEach(n => {
      setBadge(n, "waiting", "waiting");
      const t = getTime(n); if (t) t.textContent = "";
      const h = getHeader(n); if (h) h.classList.remove("stage-active","stage-done");
    });
    statusBar.textContent = "IDLE";
    costEl.textContent = "$0.00";
  }

  function addLog(text: string, cls = "text-zinc-500") {
    const row = document.createElement("div");
    row.className = `${cls} opacity-0 transition-opacity duration-200`;
    row.textContent = text;
    log.appendChild(row);
    requestAnimationFrame(() => { row.classList.remove("opacity-0"); });
    log.scrollTop = log.scrollHeight;
    // Keep last N lines
    while (log.children.length > 14) log.removeChild(log.children[0]);
  }

  function delay(ms: number) { return new Promise<void>(r => setTimeout(r, ms)); }

  async function runStage(stage: StageScript, startTime: number): Promise<void> {
    const h = getHeader(stage.name); if (h) h.classList.add("stage-active");
    setBadge(stage.name, "active", "running");
    statusBar.textContent = `otta:${stage.name.toUpperCase()} — ACTIVE`;

    let elapsed = 0;
    for (const line of stage.lines) {
      await delay(line.delay);
      elapsed += line.delay;
      const cost = ((Date.now() - startTime) / 1000 * 0.004).toFixed(2);
      costEl.textContent = `$${cost}`;
      addLog(line.text, line.cls ?? "text-zinc-500");
    }
    await delay(Math.max(0, stage.duration - elapsed));

    const h2 = getHeader(stage.name); if (h2) { h2.classList.remove("stage-active"); h2.classList.add("stage-done"); }
    const runMs = Date.now() - startTime;
    const t = getTime(stage.name); if (t) t.textContent = `${(runMs / 1000).toFixed(1)}s`;
    setBadge(stage.name, stage.passes ? "pass" : "fail", stage.passes ? "pass" : "fail");
  }

  async function playRun(run: PipelineRun) {
    resetRun();
    await delay(900);
    issueLabel.textContent = run.issue;
    slotLabel.textContent = run.slot;
    addLog(`→ received issue ${run.issue}`, "text-zinc-600");
    await delay(600);

    const runStart = Date.now();
    for (const stage of run.stages) {
      await runStage(stage, runStart);
    }

    statusBar.textContent = "★ MERGED · FLYWHEEL UPDATED";
    await delay(4500);
  }

  async function loop() {
    let i = 0;
    while (true) {
      await playRun(RUNS[i % RUNS.length]);
      i++;
      await delay(1200);
    }
  }

  loop();
</script>
