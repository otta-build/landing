---
import { BRAND, SITE } from "../config";
import { proofMetrics } from "../data/content";
---

<section id="hero-spotlight" class="relative overflow-hidden bg-zinc-950 text-white">

  <!-- Animated gradient orbs -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="hero-orb hero-orb-1 absolute -top-60 left-[20%] h-[700px] w-[700px] rounded-full bg-indigo-600/[0.18] blur-[140px]"></div>
    <div class="hero-orb hero-orb-2 absolute top-40 right-[10%] h-[500px] w-[500px] rounded-full bg-violet-700/[0.12] blur-[120px]"></div>
    <div class="hero-orb hero-orb-3 absolute bottom-0 left-[40%] h-[400px] w-[400px] rounded-full bg-indigo-500/[0.08] blur-[100px]"></div>
  </div>

  <!-- Dot grid -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.035]"
    style="background-image: radial-gradient(circle, rgba(99,102,241,0.8) 1px, transparent 1px); background-size: 32px 32px;"
    aria-hidden="true"
  ></div>

  <!-- ─── HERO COPY ─── -->
  <div class="relative mx-auto w-full max-w-4xl px-4 pt-24 pb-10 text-center sm:px-6 sm:pt-32 lg:pt-36">

    <!-- Status badge -->
    <div class="hero-reveal inline-flex items-center gap-2 rounded-full border border-indigo-500/25 bg-indigo-500/10 px-4 py-1.5 mb-8">
      <span class="h-1.5 w-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
      <span class="text-xs font-semibold text-indigo-300 tracking-wide">GitHub App · executor-agnostic · open core</span>
    </div>

    <!-- Main headline -->
    <h1 class="hero-reveal hero-reveal-d1 text-5xl font-black tracking-tight leading-[0.92] sm:text-6xl lg:text-[5.5rem] mb-6">
      The self-learning<br>
      <span class="gradient-heading">AI software factory.</span>
    </h1>

    <p class="hero-reveal hero-reveal-d2 mx-auto max-w-2xl text-lg text-zinc-400 leading-relaxed mb-10">
      Four specialized agents. Merge-blocking GitHub App gates. A flywheel that turns every failure into a preflight rule — so each build is cheaper and cleaner than the last.
    </p>

    <!-- CTAs -->
    <div class="hero-reveal hero-reveal-d3 flex flex-col items-center gap-3 sm:flex-row sm:justify-center mb-4">
      <a
        href="#get-started"
        class="rounded-lg bg-indigo-600 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-600/30 transition-all hover:bg-indigo-500 hover:scale-[1.02] hover:shadow-indigo-500/40"
      >
        Get started
      </a>
      <a
        href={SITE.bookingUrl}
        class="rounded-lg border border-zinc-700/80 px-7 py-3 text-sm font-semibold text-zinc-300 transition-colors hover:border-zinc-500 hover:text-white"
      >
        Book a walkthrough
      </a>
    </div>

    <!-- Scenario label -->
    <div class="hero-reveal hero-reveal-d4 mt-8 mb-3">
      <span id="scenario-label" class="inline-block font-mono text-[11px] text-zinc-600 tracking-widest uppercase transition-opacity duration-500">
        scenario 1 of 2 — flywheel prevents a repeat failure
      </span>
    </div>
  </div>

  <!-- ─── PIPELINE VISUALIZER ─── -->
  <div class="hero-reveal hero-reveal-d5 relative mx-auto w-full max-w-5xl px-4 pb-16 sm:px-6">
    <div class="rounded-2xl border border-zinc-800/60 bg-black/70 backdrop-blur-sm overflow-hidden shadow-2xl shadow-black/60">

      <!-- Window chrome -->
      <div class="flex items-center justify-between border-b border-zinc-900 px-5 py-3">
        <div class="flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-zinc-700/80"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-zinc-700/80"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-zinc-700/80"></span>
          <span class="ml-3 font-mono text-[11px] text-zinc-600">otta · pipeline · <span id="pipe-issue-label" class="text-zinc-500">&nbsp;</span></span>
        </div>
        <div class="flex items-center gap-4">
          <span id="pipe-cost" class="font-mono text-[10px] text-zinc-700">$0.00</span>
          <span id="pipe-elapsed" class="font-mono text-[10px] text-zinc-700">0s</span>
          <span class="flex items-center gap-1">
            <span class="h-1.5 w-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
            <span class="font-mono text-[10px] text-zinc-600 tracking-widest uppercase">live</span>
          </span>
        </div>
      </div>

      <!-- Stage headers -->
      <div class="grid grid-cols-4 border-b border-zinc-900">
        {["builder", "reviewer", "qa", "devops"].map((name, i) => (
          <div id={`stage-${name}`} class={`stage-header px-3 py-3 ${i < 3 ? "border-r border-zinc-900" : ""}`}>
            <div class="font-mono text-[9px] text-zinc-700 tracking-widest uppercase mb-1">0{i + 1}</div>
            <div class="font-mono text-[11px] font-bold text-zinc-500">otta:{name}</div>
            <div id={`stage-${name}-badge`} class="stage-badge mt-2 inline-flex items-center gap-1.5 rounded px-1.5 py-0.5 font-mono text-[9px] font-bold uppercase tracking-wider waiting-badge">
              <span class="stage-dot h-1 w-1 rounded-full"></span>
              <span class="stage-label">waiting</span>
            </div>
            <div id={`stage-${name}-time`} class="mt-1 font-mono text-[9px] text-zinc-700 h-3"></div>
          </div>
        ))}
      </div>

      <!-- Log output -->
      <div id="pipeline-log" class="font-mono text-[11px] leading-relaxed px-5 py-4 min-h-[168px] max-h-[168px] overflow-hidden space-y-1.5">
        <div class="text-zinc-800">// initializing otta pipeline...</div>
      </div>

      <!-- Footer -->
      <div class="flex items-center justify-between border-t border-zinc-900 px-5 py-2">
        <div class="font-mono text-[10px] text-zinc-700">OTTA PULSE · CHECKS API · GEPA FLYWHEEL</div>
        <div id="pipe-status-bar" class="font-mono text-[10px] text-zinc-700">IDLE</div>
      </div>
    </div>

    <!-- Progress dots -->
    <div class="flex justify-center gap-2 mt-4">
      <span id="dot-0" class="h-1.5 w-4 rounded-full bg-indigo-500 transition-all duration-300"></span>
      <span id="dot-1" class="h-1.5 w-1.5 rounded-full bg-zinc-700 transition-all duration-300"></span>
    </div>
  </div>

  <!-- ─── ARCHITECTURE CARDS ─── -->
  <div class="relative mx-auto w-full max-w-7xl px-4 pb-16 sm:px-6">
    <div class="text-[10px] font-bold tracking-[0.2em] text-zinc-700 uppercase border-b border-zinc-900 pb-3 mb-6">
      // CORE ARCHITECTURE
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { num: "01", tag: "Rules Layer", title: "Global standing orders", body: "Team-wide constraints, strict typechecks, TDD-first. Prompts drift — rules don't." },
        { num: "02", tag: "Orchestration", title: "4-stage agent pipeline", body: "builder → reviewer → qa → devops. Specialized roles. None can self-approve." },
        { num: "03", tag: "Memory Layer", title: "Brain + cross-agent recall", body: "Git-canonical brain + mem0 recall bus. Past failures become preflight guards." },
        { num: "04", tag: "GEPA Flywheel", title: "Self-learning optimizer", body: "Pipeline verdicts feed GEPA. Prompts rewrite from outcomes — 35× fewer rollouts than RL." },
      ].map(c => (
        <div class="group relative rounded-xl border border-zinc-900 bg-zinc-950 p-5 overflow-hidden transition-all duration-300 hover:border-indigo-500/20 hover:bg-zinc-900/60 hover:-translate-y-0.5">
          <div class="absolute top-3 right-4 font-mono text-5xl font-black text-white/[0.035] group-hover:text-indigo-500/[0.07] transition-colors select-none">{c.num}</div>
          <span class="inline-block rounded bg-indigo-600/10 border border-indigo-500/20 px-2 py-0.5 font-mono text-[9px] font-bold uppercase tracking-widest text-indigo-400">{c.tag}</span>
          <h3 class="mt-4 text-sm font-bold text-white">{c.title}</h3>
          <p class="mt-1.5 text-[11px] text-zinc-600 leading-relaxed">{c.body}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- ─── METRICS STRIP ─── -->
  <div class="relative mx-auto w-full max-w-7xl px-4 pb-20 sm:px-6">
    <div class="border-t border-zinc-900 pt-10">
      <p class="text-[10px] font-bold tracking-[0.2em] text-zinc-700 uppercase mb-7">
        Otta observability metrics · last 90 days
      </p>
      <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-6">
        {proofMetrics.map(m => (
          <div>
            <div class="text-2xl font-black font-mono text-white sm:text-3xl">{m.value}</div>
            <div class="mt-1 text-xs font-semibold text-indigo-400">{m.label}</div>
            <div class="text-[11px] text-zinc-700">{m.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

</section>

<style>
  .gradient-heading {
    background: linear-gradient(135deg, #818cf8 0%, #a78bfa 40%, #c084fc 70%, #e879f9 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @keyframes orb-drift-1 {
    0%,100% { transform: translate(0,0) scale(1); }
    33% { transform: translate(60px,-40px) scale(1.08); }
    66% { transform: translate(-30px,50px) scale(0.95); }
  }
  @keyframes orb-drift-2 {
    0%,100% { transform: translate(0,0) scale(1); }
    40% { transform: translate(-50px,30px) scale(1.05); }
    70% { transform: translate(40px,-60px) scale(0.97); }
  }
  @keyframes orb-drift-3 {
    0%,100% { transform: translate(0,0) scale(1); }
    50% { transform: translate(30px,-30px) scale(1.1); }
  }
  .hero-orb-1 { animation: orb-drift-1 18s ease-in-out infinite; }
  .hero-orb-2 { animation: orb-drift-2 22s ease-in-out infinite; }
  .hero-orb-3 { animation: orb-drift-3 15s ease-in-out infinite; }

  .hero-reveal {
    opacity: 0;
    transform: translateY(20px);
    animation: hero-fade-up 0.7s ease-out forwards;
  }
  .hero-reveal-d1 { animation-delay: 0.1s; }
  .hero-reveal-d2 { animation-delay: 0.2s; }
  .hero-reveal-d3 { animation-delay: 0.32s; }
  .hero-reveal-d4 { animation-delay: 0.44s; }
  .hero-reveal-d5 { animation-delay: 0.56s; }
  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Badge states */
  .waiting-badge { background: rgba(255,255,255,0.03); color: #3f3f46; }
  .waiting-badge .stage-dot { background: #3f3f46; }

  .active-badge { background: rgba(99,102,241,0.14); color: #a5b4fc; border: 1px solid rgba(99,102,241,0.28); }
  .active-badge .stage-dot { background: #818cf8; animation: blink 1s ease-in-out infinite; }

  .pass-badge { background: rgba(52,211,153,0.1); color: #6ee7b7; border: 1px solid rgba(52,211,153,0.22); }
  .pass-badge .stage-dot { background: #6ee7b7; }

  .skip-badge { background: rgba(251,191,36,0.08); color: #fcd34d; border: 1px solid rgba(251,191,36,0.2); }
  .skip-badge .stage-dot { background: #fcd34d; }

  @keyframes blink { 0%,100%{opacity:1;} 50%{opacity:0.35;} }

  .stage-header.stage-active  { background: rgba(99,102,241,0.05); }
  .stage-header.stage-done    { background: rgba(52,211,153,0.03); }
  .stage-header.stage-skip    { background: rgba(251,191,36,0.03); }
</style>

<script>
  // ─── Helpers ───
  const log       = document.getElementById("pipeline-log")!;
  const issueEl   = document.getElementById("pipe-issue-label")!;
  const costEl    = document.getElementById("pipe-cost")!;
  const elapsedEl = document.getElementById("pipe-elapsed")!;
  const statusBar = document.getElementById("pipe-status-bar")!;
  const scenLabel = document.getElementById("scenario-label")!;
  const STAGES    = ["builder", "reviewer", "qa", "devops"];

  function $badge(n: string) { return document.getElementById(`stage-${n}-badge`); }
  function $time(n: string)  { return document.getElementById(`stage-${n}-time`); }
  function $hdr(n: string)   { return document.getElementById(`stage-${n}`); }

  function setBadge(name: string, state: "waiting"|"active"|"pass"|"skip", label: string) {
    const b = $badge(name); if (!b) return;
    b.className = `stage-badge mt-2 inline-flex items-center gap-1.5 rounded px-1.5 py-0.5 font-mono text-[9px] font-bold uppercase tracking-wider ${state}-badge`;
    (b.querySelector(".stage-label") as HTMLElement).textContent = label;
  }

  function addLog(text: string, cls = "text-zinc-500") {
    const row = document.createElement("div");
    row.className = `${cls} opacity-0 transition-opacity duration-300`;
    row.textContent = text;
    log.appendChild(row);
    requestAnimationFrame(() => row.classList.remove("opacity-0"));
    log.scrollTop = log.scrollHeight;
    while (log.children.length > 12) log.removeChild(log.children[0]);
  }

  function delay(ms: number) { return new Promise<void>(r => setTimeout(r, ms)); }

  let runStart = 0;
  let costInterval: ReturnType<typeof setInterval> | null = null;

  function startCostTicker(ratePerSec: number) {
    if (costInterval) clearInterval(costInterval);
    costInterval = setInterval(() => {
      const elapsed = (Date.now() - runStart) / 1000;
      costEl.textContent = `$${(elapsed * ratePerSec).toFixed(2)}`;
      elapsedEl.textContent = `${Math.floor(elapsed)}s`;
    }, 250);
  }
  function stopCostTicker() {
    if (costInterval) { clearInterval(costInterval); costInterval = null; }
  }

  function resetRun() {
    log.innerHTML = "";
    costEl.textContent = "$0.00";
    elapsedEl.textContent = "0s";
    stopCostTicker();
    STAGES.forEach(n => {
      setBadge(n, "waiting", "waiting");
      const t = $time(n); if (t) t.textContent = "";
      const h = $hdr(n); if (h) h.className = h.className.replace(/stage-(active|done|skip)/g, "").trim();
    });
    statusBar.textContent = "IDLE";
  }

  interface StageDef {
    name: string;
    label?: string; // badge label
    lines: { text: string; cls?: string; delay: number }[];
    state?: "pass"|"skip";
  }

  interface RunDef {
    issue: string;
    scenario: string;
    stages: StageDef[];
    finalLine: string;
    finalCls?: string;
    cost: string;
  }

  const RUNS: RunDef[] = [
    // ─── SCENARIO 1: Flywheel prevents a class of repeat failure ───
    {
      issue: '"payment-retry-logic" #88',
      scenario: "scenario 1 of 2 — flywheel prevents a repeat failure",
      cost: "$0.21",
      finalLine: "★ PR #89 merged in 4m12s · flywheel: guard auto-promoted to preflight",
      finalCls: "text-amber-300 font-bold",
      stages: [
        {
          name: "builder",
          lines: [
            { text: "→ loading brain context: 312 rules + 14 project gotchas", cls: "text-zinc-600", delay: 500 },
            { text: "  ⚡ brain recalled: 'idempotency key missing → duplicate charges'", cls: "text-amber-400 font-semibold", delay: 700 },
            { text: "  ⚡ brain recalled: 'retry must be exponential, not fixed 500ms'", cls: "text-amber-400 font-semibold", delay: 600 },
            { text: "→ worktree created on slot-03 · executor: claude-code", cls: "text-zinc-600", delay: 700 },
            { text: "  writing failing test: test_idempotency_key_present", cls: "text-zinc-600", delay: 800 },
            { text: "  writing failing test: test_retry_is_exponential", cls: "text-zinc-600", delay: 500 },
            { text: "✓ PASS test_idempotency_key_present", cls: "text-emerald-400", delay: 900 },
            { text: "✓ PASS test_retry_is_exponential", cls: "text-emerald-400", delay: 700 },
            { text: "  typecheck: strict · 0 errors · preflight: PASS", cls: "text-zinc-600", delay: 700 },
          ],
        },
        {
          name: "reviewer",
          lines: [
            { text: "→ spec: issue #88 — 3 ACs", cls: "text-zinc-600", delay: 500 },
            { text: "  AC1: idempotency key on every charge attempt ✓", cls: "text-zinc-500", delay: 700 },
            { text: "  AC2: retry delay doubles each attempt (max 30s) ✓", cls: "text-zinc-500", delay: 700 },
            { text: "  AC3: no duplicate charge on network timeout ✓", cls: "text-zinc-500", delay: 700 },
            { text: "  surgical: 2 files · 0 unrelated changes ✓", cls: "text-zinc-600", delay: 600 },
          ],
        },
        {
          name: "qa",
          lines: [
            { text: "→ adversarial: forcing network timeout during payment...", cls: "text-zinc-600", delay: 600 },
            { text: "  result: single charge · idempotency key held ✓", cls: "text-emerald-400", delay: 900 },
            { text: "→ adversarial: sending duplicate webhook events...", cls: "text-zinc-600", delay: 600 },
            { text: "  result: deduplicated correctly · no double-process ✓", cls: "text-emerald-400", delay: 900 },
            { text: "  regression: 82 existing payment tests PASS ✓", cls: "text-zinc-500", delay: 700 },
          ],
        },
        {
          name: "devops",
          state: "skip",
          label: "merged",
          lines: [
            { text: "→ PR #89 opened · Otta Pulse checks registered", cls: "text-zinc-600", delay: 500 },
            { text: "  acceptance-gate ✓  coverage-gate ✓  typecheck-gate ✓", cls: "text-emerald-400", delay: 700 },
            { text: "  GEPA: verdict stored — idempotency + retry patterns", cls: "text-zinc-600", delay: 700 },
            { text: "  flywheel: 2 patterns → confidence 0.94 → GRADUATED", cls: "text-amber-400 font-semibold", delay: 800 },
            { text: "  brain update: new preflight guard added for all future PRs", cls: "text-amber-400", delay: 700 },
          ],
        },
      ],
    },

    // ─── SCENARIO 2: Multi-agent pipeline catches a logic hole CI missed ───
    {
      issue: '"dashboard-export-csv" #103',
      scenario: "scenario 2 of 2 — pipeline catches what CI missed",
      cost: "$0.17",
      finalLine: "★ PR #104 merged · defect rate: 0 on 6 CI-green PRs shipped today",
      finalCls: "text-indigo-300 font-bold",
      stages: [
        {
          name: "builder",
          lines: [
            { text: "→ brain: no prior gotchas for CSV export — clean slate", cls: "text-zinc-600", delay: 500 },
            { text: "→ worktree: slot-01 · executor: claude-code", cls: "text-zinc-600", delay: 600 },
            { text: "  TDD: test_csv_headers_match_schema", cls: "text-zinc-600", delay: 800 },
            { text: "  TDD: test_csv_escapes_special_chars", cls: "text-zinc-600", delay: 500 },
            { text: "  TDD: test_csv_empty_dataset_returns_headers_only", cls: "text-zinc-600", delay: 500 },
            { text: "✓ PASS all 3 tests · typecheck: PASS", cls: "text-emerald-400", delay: 900 },
            { text: "  CI would have shipped this. Otta keeps going.", cls: "text-zinc-700 italic", delay: 700 },
          ],
        },
        {
          name: "reviewer",
          lines: [
            { text: "→ spec: issue #103 — 4 ACs", cls: "text-zinc-600", delay: 500 },
            { text: "  AC1: CSV includes all visible columns ✓", cls: "text-zinc-500", delay: 700 },
            { text: "  AC2: special chars escaped (RFC 4180) ✓", cls: "text-zinc-500", delay: 700 },
            { text: "  AC3: empty export returns headers-only row ✓", cls: "text-zinc-500", delay: 700 },
            { text: "  AC4: export respects active row filters ✗", cls: "text-rose-400 font-semibold", delay: 800 },
            { text: "  GAPS: filter state not passed to CSV serializer", cls: "text-rose-400", delay: 600 },
            { text: "→ SPEC-FAIL · returning to builder with gap report", cls: "text-rose-400 font-semibold", delay: 600 },
          ],
        },
        {
          name: "builder",
          label: "retry",
          lines: [
            { text: "→ builder resuming with reviewer gap report", cls: "text-zinc-600", delay: 500 },
            { text: "  TDD: test_csv_respects_active_filters", cls: "text-zinc-600", delay: 700 },
            { text: "✕ FAIL test_csv_respects_active_filters (unfiltered data)", cls: "text-rose-400 font-semibold", delay: 800 },
            { text: "  fixing: thread filter context into CSV serializer", cls: "text-zinc-600", delay: 1100 },
            { text: "✓ PASS test_csv_respects_active_filters", cls: "text-emerald-400", delay: 900 },
            { text: "✓ PASS all 4 tests · handing to reviewer", cls: "text-emerald-400", delay: 600 },
          ],
        },
        {
          name: "reviewer",
          label: "verify",
          lines: [
            { text: "  AC4: export respects active row filters ✓ (re-verified)", cls: "text-zinc-500", delay: 600 },
            { text: "→ spec compliance: PASS · all 4 ACs satisfied", cls: "text-indigo-400 font-semibold", delay: 600 },
          ],
        },
        {
          name: "qa",
          lines: [
            { text: "→ adversarial: exporting with 3 active filters applied...", cls: "text-zinc-600", delay: 600 },
            { text: "  result: CSV contains only filtered rows ✓", cls: "text-emerald-400", delay: 900 },
            { text: "  adversarial: large dataset (50k rows) export...", cls: "text-zinc-600", delay: 600 },
            { text: "  result: streaming · no memory spike ✓", cls: "text-emerald-400", delay: 900 },
          ],
        },
        {
          name: "devops",
          lines: [
            { text: "→ PR #104 opened with full evidence body", cls: "text-zinc-600", delay: 500 },
            { text: "  Pulse gates: acceptance ✓  coverage ✓  typecheck ✓", cls: "text-emerald-400", delay: 700 },
            { text: "  GEPA: verdict stored — filter-threading pattern", cls: "text-zinc-600", delay: 700 },
            { text: "  note: this defect was invisible to CI — caught by reviewer", cls: "text-amber-400", delay: 800 },
          ],
        },
      ],
    },
  ];

  // Stages we animate sequentially — builder can appear twice in scenario 2
  async function animateStage(stage: StageDef, stageIdx: number): Promise<void> {
    const sname = stage.name;
    const h = $hdr(sname);
    if (h) {
      h.className = h.className.replace(/\bstage-(active|done|skip)\b/g, "").trim();
      h.classList.add("stage-active");
    }
    setBadge(sname, "active", stage.label ?? "running");
    statusBar.textContent = `otta:${sname.toUpperCase()} — ${(stage.label ?? "active").toUpperCase()}`;

    const stageStart = Date.now();
    for (const line of stage.lines) {
      await delay(line.delay);
      addLog(line.text, line.cls ?? "text-zinc-500");
    }
    await delay(400);

    const elapsed = ((Date.now() - stageStart) / 1000).toFixed(1);
    const t = $time(sname); if (t) t.textContent = `${elapsed}s`;
    if (h) {
      h.classList.remove("stage-active");
      h.classList.add(stage.state === "skip" ? "stage-skip" : "stage-done");
    }
    setBadge(sname, stage.state ?? "pass", stage.state === "skip" ? "merged" : "pass");
  }

  async function playRun(run: RunDef, runIdx: number) {
    resetRun();
    await delay(700);

    // Update UI labels
    issueEl.textContent = run.issue;
    scenLabel.textContent = run.scenario;

    // Update progress dots
    const d0 = document.getElementById("dot-0");
    const d1 = document.getElementById("dot-1");
    if (runIdx === 0) {
      d0?.classList.replace("bg-zinc-700", "bg-indigo-500");
      d0?.classList.replace("w-1.5", "w-4");
      d1?.classList.replace("bg-indigo-500", "bg-zinc-700");
      d1?.classList.replace("w-4", "w-1.5");
    } else {
      d1?.classList.replace("bg-zinc-700", "bg-indigo-500");
      d1?.classList.replace("w-1.5", "w-4");
      d0?.classList.replace("bg-indigo-500", "bg-zinc-700");
      d0?.classList.replace("w-4", "w-1.5");
    }

    runStart = Date.now();
    startCostTicker(0.004);

    addLog(`→ received issue ${run.issue}`, "text-zinc-700");
    await delay(500);

    for (let i = 0; i < run.stages.length; i++) {
      await animateStage(run.stages[i], i);
      await delay(350);
    }

    stopCostTicker();
    costEl.textContent = run.cost;
    addLog(run.finalLine, run.finalCls ?? "text-indigo-300 font-bold");
    statusBar.textContent = "PIPELINE COMPLETE";
    await delay(5500);
  }

  async function loop() {
    let i = 0;
    while (true) {
      await playRun(RUNS[i % RUNS.length], i % RUNS.length);
      i++;
      await delay(1200);
    }
  }

  loop();
</script>
