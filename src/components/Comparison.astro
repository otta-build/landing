---
import { BRAND } from "../config";
import { comparisonRows } from "../data/content";
---

<section class="bg-slate-950 text-white">
  <div class="mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold tracking-wide text-indigo-400 uppercase">
        Head to head
      </p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
        A different bet than the big agent platforms.
      </h2>
      <p class="mt-4 text-lg text-slate-300">
        Generic agent platforms optimize for raw autonomy at enterprise scale.
        {BRAND} optimizes for provable quality, persistent memory, and data you control.
      </p>
    </div>

    <div class="mt-12 overflow-hidden rounded-2xl border border-white/10">
      <!-- header row -->
      <div class="hidden grid-cols-[1fr_1.3fr_1.3fr] gap-px bg-white/10 md:grid">
        <div class="bg-slate-950 px-5 py-4 text-xs font-semibold tracking-wide text-slate-400 uppercase"></div>
        <div class="bg-indigo-600 px-5 py-4 text-sm font-bold">{BRAND}</div>
        <div class="bg-slate-900 px-5 py-4 text-sm font-bold text-slate-300">Generic agent platforms</div>
      </div>
      <div class="grid gap-px bg-white/10">
        {
          comparisonRows.map(row => (
            <div class="grid gap-px bg-white/10 md:grid-cols-[1fr_1.3fr_1.3fr]">
              <div class="bg-slate-950 px-5 py-4 text-sm font-semibold text-white">
                {row.dimension}
              </div>
              <div class="bg-slate-950 px-5 py-4 text-sm text-slate-200 md:bg-indigo-600/10">
                <span class="md:hidden mr-1 text-xs font-semibold text-indigo-400 uppercase">{BRAND}: </span>
                <span class="inline-flex items-start gap-2">
                  <svg class="mt-0.5 h-4 w-4 flex-none text-indigo-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.6a1 1 0 0 1-1.42 0l-3.5-3.48a1 1 0 1 1 1.41-1.42l2.8 2.77 6.79-6.88a1 1 0 0 1 1.42.01Z" clip-rule="evenodd" />
                  </svg>
                  <span>{row.us}</span>
                </span>
              </div>
              <div class="bg-slate-950 px-5 py-4 text-sm text-slate-400">
                <span class="md:hidden mr-1 text-xs font-semibold text-slate-500 uppercase">Them: </span>
                {row.them}
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <p class="mt-4 text-xs text-slate-500">
      Comparison reflects publicly documented positioning and independent reviews of
      enterprise agent platforms; capabilities change over time.
    </p>
  </div>
</section>
