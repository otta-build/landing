---
/**
 * Google Consent Mode v2 — default-deny bootstrap.
 *
 * MUST render in <head> ABOVE <Gtm>. gtag() is a dataLayer.push wrapper, so the
 * consent default lands in the same queue GTM drains on load — GTM then evaluates
 * every tag under "denied" from the first tick. Placing this after <Gtm> would let
 * tags fire once under the implicit default-granted state before the deny applies.
 *
 * Flow:
 *   1. default: deny ad_storage / ad_user_data / ad_personalization / analytics_storage
 *      / personalization_storage. Grant security_storage. (functionality granted.)
 *   2. url_passthrough + ads_data_redaction → recover modelled signal while denied.
 *   3. Returning visitor: if a prior "granted" choice is in localStorage, update to
 *      granted immediately so their tags fire without re-consenting.
 *
 * Pair with <ConsentBanner> (the visible opt-in) and <Gtm> (loads after this).
 */
interface Props {
  /**
   * localStorage key holding the persisted choice. Keep identical to the value
   * passed to <ConsentBanner> so read/write agree. Default: "lc-consent".
   */
  storageKey?: string;
  /** ms GTM waits for an update before acting on defaults. Default 500. */
  waitForUpdate?: number;
}
const { storageKey = "lc-consent", waitForUpdate = 500 } = Astro.props;
---

<!-- Google Consent Mode v2 (default-deny) — must precede GTM -->
<script is:inline define:vars={{ storageKey, waitForUpdate }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    window.dataLayer.push(arguments);
  }
  window.gtag = window.gtag || gtag;

  gtag("consent", "default", {
    ad_storage: "denied",
    ad_user_data: "denied",
    ad_personalization: "denied",
    analytics_storage: "denied",
    personalization_storage: "denied",
    functionality_storage: "granted",
    security_storage: "granted",
    wait_for_update: waitForUpdate,
  });

  // Recover signal while denied: pass gclid via URL, redact ad data.
  gtag("set", "url_passthrough", true);
  gtag("set", "ads_data_redaction", true);

  // Returning visitor who already granted → lift consent before tags evaluate.
  try {
    var stored = localStorage.getItem(storageKey);
    if (stored) {
      var choice = JSON.parse(stored);
      if (choice && choice.granted) {
        gtag("consent", "update", {
          ad_storage: "granted",
          ad_user_data: "granted",
          ad_personalization: "granted",
          analytics_storage: "granted",
          personalization_storage: "granted",
        });
      }
    }
  } catch (_) {
    /* localStorage blocked (private mode) → stay denied. */
  }
</script>
<!-- End Google Consent Mode v2 -->
