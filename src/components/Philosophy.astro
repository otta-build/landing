---
import { philosophy } from "../data/content";
---

<section class="relative overflow-hidden border-y border-indigo-900/40 bg-zinc-950" style="background: radial-gradient(ellipse 80% 60% at 50% 50%, rgba(99,102,241,0.07) 0%, transparent 70%), #09090b">
  <div class="mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <h2 class="reveal reveal-left text-3xl font-bold tracking-tight text-white sm:text-5xl">
        {philosophy.quote}
      </h2>
      <p class="reveal reveal-d1 text-lg leading-relaxed text-zinc-400">
        {philosophy.body}
      </p>
    </div>
  </div>
</section>
