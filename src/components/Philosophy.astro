---
import { philosophy } from "../data/content";
---

<section class="otta-section overflow-hidden bg-indigo-600/10 text-white">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_22%_40%,rgba(124,108,255,.2),transparent_38%)]"></div>
  <div class="mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="relative grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <h2 class="text-3xl font-bold tracking-[-0.035em] sm:text-5xl">
        {philosophy.quote}
      </h2>
      <p class="text-lg leading-relaxed text-zinc-300">
        {philosophy.body}
      </p>
    </div>
  </div>
</section>
