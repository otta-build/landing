---
import { philosophy } from "../data/content";
---

<section class="bg-emerald-600 text-white">
  <div class="mx-auto w-full max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-5xl">
        {philosophy.quote}
      </h2>
      <p class="text-lg leading-relaxed text-emerald-100">
        {philosophy.body}
      </p>
    </div>
  </div>
</section>
