---
import "../styles/global.css";
import { BRAND, SITE } from "../config";

// OTT-71: without this file Cloudflare Pages served index.html for every
// unknown path, with a 200. That made /robots.txt, /sitemap.xml and /rss.xml
// look like they existed and returned HTML — a missing file was
// indistinguishable from a served one. Astro emits this as dist/404.html and
// Pages returns it with a real 404 status.
const title = `Not found — ${BRAND}`;
---

<html lang="en" data-theme="otta-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
  </head>
  <body class="bg-[#07070b] text-white antialiased">
    <main class="relative mx-auto flex min-h-screen w-full max-w-2xl flex-col items-center justify-center overflow-hidden px-6 text-center">
      <a href="/" class="mb-10 flex items-center gap-2 text-sm font-bold tracking-tight text-white">
        <svg class="h-7 w-7" viewBox="0 0 1024 1024" aria-hidden="true">
          <defs>
            <linearGradient id="notfoundlogo" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#7C6CFF" />
              <stop offset="1" stop-color="#3F2FB8" />
            </linearGradient>
          </defs>
          <rect width="1024" height="1024" rx="232" fill="url(#notfoundlogo)" />
          <path d="M 512 250 A 262 262 0 1 1 304 360" fill="none" stroke="#fff" stroke-width="86" stroke-linecap="round" />
          <circle cx="512" cy="250" r="70" fill="#fff" />
        </svg>
        {BRAND}
      </a>

      <p class="font-mono text-sm tracking-widest text-indigo-400">404</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        This page didn't make it through the gate.
      </h1>
      <p class="mt-4 max-w-md text-base text-zinc-400">
        Nothing lives at this URL. Check the link, or start from the homepage.
      </p>

      <div class="mt-9 flex flex-col items-center gap-3 sm:flex-row">
        <a
          href="/"
          class="rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-indigo-500"
        >
          Back to {BRAND}
        </a>
        <a
          href={SITE.waitlistUrl}
          class="rounded-lg px-5 py-2.5 text-sm font-semibold text-zinc-300 transition-colors hover:text-white"
        >
          Get access →
        </a>
      </div>
    </main>
  </body>
</html>
