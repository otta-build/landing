---
import "../styles/global.css";
import { BRAND, SITE } from "../config";
import { answerPages, type AnswerPage } from "../data/answers";

// One route per GEO answer page (#7, #8, #9). The pages are data, not markup:
// three near-identical copies of a head, a nav and a FAQ block would drift
// apart on the first edit, and the FAQ drifting from its schema is the exact
// failure Google penalises.
export function getStaticPaths() {
  return answerPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

interface Props { page: AnswerPage }
const { page } = Astro.props;

const pageUrl = new URL(`/${page.slug}/`, SITE.website).href;

// FAQ schema is built from the same array the visible copy renders from, so
// the two cannot disagree.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      mainEntity: page.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
    {
      "@type": "WebPage",
      "@id": pageUrl,
      url: pageUrl,
      name: page.title,
      description: page.description,
      isPartOf: { "@type": "WebSite", name: BRAND, url: SITE.website },
      about: {
        "@type": "SoftwareApplication",
        name: BRAND,
        applicationCategory: "DeveloperApplication",
        operatingSystem: "GitHub",
        url: SITE.website,
      },
    },
  ],
};

const POSTHOG_KEY =
  import.meta.env.PUBLIC_POSTHOG_KEY ?? "phc_xP54prf7PUmJCFrtD9W3zBCEyuM3822XmKuz8HBGNFdh";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={page.description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Otta" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={new URL("/og.png", SITE.website).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={new URL("/og.png", SITE.website).href} />
    <title>{page.title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <!-- PostHog Analytics -->
    <script is:inline define:vars={{ phKey: POSTHOG_KEY }}>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);for(r=e,void 0!==a?r=e[a]=[]:a="posthog",r.people=r.people||[],r.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},r.people.toString=function(){return r.toString(1)+".people (stub)"},o="init capture register register_once track_pageview register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment get_group_property onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey getNextSurveyStep identify setPersonProperties group reset resetGroups set_config register_config_callback get_config_callback get_property getSessionId".split(" "),n=0;n<o.length;n++)g(r,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      window.posthog.init(phKey,{api_host:'https://us.i.posthog.com', person_profiles:'identified_only'});
    </script>
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <header class="sticky top-0 z-20 border-b border-white/10 bg-slate-950/80 backdrop-blur">
      <nav class="mx-auto flex w-full max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6">
        <a href="/" class="flex items-center gap-2 text-sm font-bold tracking-tight text-white">
          <svg class="h-6 w-6" viewBox="0 0 1024 1024" aria-hidden="true">
            <defs>
              <linearGradient id="navlogo" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#7C6CFF" />
                <stop offset="1" stop-color="#3F2FB8" />
              </linearGradient>
            </defs>
            <rect width="1024" height="1024" rx="232" fill="url(#navlogo)" />
            <path d="M 512 250 A 262 262 0 1 1 304 360" fill="none" stroke="#fff" stroke-width="86" stroke-linecap="round" />
            <circle cx="512" cy="250" r="70" fill="#fff" />
          </svg>
          {BRAND}
        </a>
        <div class="hidden items-center gap-7 text-sm text-slate-300 md:flex">
          <a href="/#pipeline" class="hover:text-white">Pipeline</a>
          <a href="/#pricing" class="hover:text-white">Pricing</a>
          <a href={SITE.bookingUrl} class="hover:text-white">Book a call</a>
        </div>
        <a
          href={`/${SITE.waitlistUrl}`}
          class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-indigo-500"
        >
          Get access
        </a>
      </nav>
    </header>

    <main>
      <!-- Answer hero: the question, then the liftable answer immediately under it. -->
      <section class="bg-zinc-950 text-white">
        <div class="mx-auto w-full max-w-4xl px-4 py-16 sm:px-6 sm:py-24">
          <p class="text-sm font-semibold tracking-wide text-indigo-400 uppercase">
            {page.eyebrow}
          </p>
          <h1 class="mt-3 text-3xl font-black tracking-tight sm:text-5xl">{page.h1}</h1>
          <p class="mt-5 text-sm text-zinc-400">{page.prompt}</p>
          <p class="mt-6 text-lg leading-relaxed text-zinc-200">{page.directAnswer}</p>
          <div class="mt-8 flex flex-col gap-3.5 sm:flex-row">
            <a
              href={`/${SITE.waitlistUrl}`}
              class="rounded-lg bg-indigo-600 px-6 py-3.5 text-center text-sm font-semibold text-white transition-colors hover:bg-indigo-500"
            >
              Get access
            </a>
            <a
              href="/"
              class="rounded-lg border border-white/15 px-6 py-3.5 text-center text-sm font-semibold text-white transition-colors hover:bg-white/5"
            >
              See how Otta works
            </a>
          </div>
        </div>
      </section>

      {
        page.sections.map((section) => (
          <section class="border-t border-gray-100 bg-white">
            <div class="mx-auto w-full max-w-4xl px-4 py-16 sm:px-6">
              <h2 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
                {section.heading}
              </h2>
              <p class="mt-4 text-lg leading-relaxed text-gray-600">{section.body}</p>
              {section.points && (
                <div class="mt-10 grid gap-6 sm:grid-cols-2">
                  {section.points.map((point) => (
                    <div class="rounded-2xl border border-gray-200 p-6">
                      <h3 class="text-base font-bold text-gray-900">{point.title}</h3>
                      <p class="mt-2 text-sm leading-relaxed text-gray-600">{point.body}</p>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </section>
        ))
      }

      <!-- FAQ — rendered from the same array as the FAQPage schema above. -->
      <section class="border-t border-gray-100 bg-slate-50">
        <div class="mx-auto w-full max-w-4xl px-4 py-16 sm:px-6">
          <h2 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
            Frequently asked questions
          </h2>
          <dl class="mt-8 space-y-8">
            {
              page.faqs.map((f) => (
                <div>
                  <dt class="text-base font-bold text-gray-900">{f.q}</dt>
                  <dd class="mt-2 text-sm leading-relaxed text-gray-600">{f.a}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- Sibling answers: keeps every answer page one hop from every other. -->
      <section class="border-t border-gray-100 bg-white">
        <div class="mx-auto w-full max-w-4xl px-4 py-16 sm:px-6">
          <h2 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
            Related questions
          </h2>
          <ul class="mt-6 space-y-3">
            {
              answerPages
                .filter((other) => other.slug !== page.slug)
                .map((other) => (
                  <li>
                    <a
                      href={`/${other.slug}/`}
                      class="text-base font-semibold text-indigo-600 hover:text-indigo-500"
                    >
                      {other.prompt}
                    </a>
                  </li>
                ))
            }
          </ul>
        </div>
      </section>
    </main>

    <footer class="border-t border-gray-100">
      <div class="mx-auto flex w-full max-w-7xl flex-col items-center justify-between gap-3 px-4 py-8 text-sm text-gray-500 sm:flex-row sm:px-6">
        <span>© {BRAND}. All rights reserved.</span>
      </div>
    </footer>
  </body>
</html>
