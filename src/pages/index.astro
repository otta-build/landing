---
import "../styles/global.css";
import { BRAND, SITE } from "../config";
import Hero from "../components/Hero.astro";
import Philosophy from "../components/Philosophy.astro";
import Pipeline from "../components/Pipeline.astro";
import Differentiators from "../components/Differentiators.astro";
import Memory from "../components/Memory.astro";
import Comparison from "../components/Comparison.astro";
import Pricing from "../components/Pricing.astro";
import Waitlist from "../components/Waitlist.astro";
import FinalCta from "../components/FinalCta.astro";

const title = `${BRAND} — ${SITE.tagline}`;

// OTT-71 structured data. Kept to what the page actually evidences: Otta is a
// developer tool, published by a named org, on a site with one page. No
// aggregateRating, no fabricated offer count — an unverifiable claim in JSON-LD
// is the kind of thing Google penalises and a reader can check in one click.
const origin = SITE.website;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${origin}#org`,
      name: BRAND,
      url: origin,
      logo: new URL("/logo.png", origin).href,
      description: SITE.subtitle,
    },
    {
      "@type": "WebSite",
      "@id": `${origin}#website`,
      name: BRAND,
      url: origin,
      description: SITE.subtitle,
      publisher: { "@id": `${origin}#org` },
    },
    {
      "@type": "SoftwareApplication",
      name: BRAND,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "macOS, Linux",
      url: origin,
      description: SITE.subtitle,
      publisher: { "@id": `${origin}#org` },
      featureList: [
        "Native delivery workflows for Claude Code and Codex",
        "Specialist builder, reviewer, QA, and DevOps stages",
        "GitHub merge gates and lifecycle evidence through Otta Pulse",
        "Acceptance-criteria, test, and visual-proof checks",
        "Release and deployment verification",
      ],
    },
  ],
};

// PostHog project key. Defaults to the dedicated Otta project; override via PUBLIC_POSTHOG_KEY.
const POSTHOG_KEY =
  import.meta.env.PUBLIC_POSTHOG_KEY ?? "phc_xP54prf7PUmJCFrtD9W3zBCEyuM3822XmKuz8HBGNFdh";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={SITE.subtitle} />
    <link rel="canonical" href={SITE.website} />
    <!--
      OTT-70: there was no og:image at all, and /og.png resolved to the HTML
      404 page, so sharing otta.build in Telegram, Slack or X rendered no card.
      Telegram in particular needs an absolute URL plus explicit width/height
      to commit to a large preview rather than a thumbnail, and it will not
      render SVG.
    -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={SITE.subtitle} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Otta" />
    <meta property="og:url" content={SITE.website} />
    <meta property="og:image" content={new URL("/og.png", SITE.website).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Otta — delivery control for coding agents. Claude Code and Codex build behind specialist review stages and Pulse-enforced GitHub evidence."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={SITE.subtitle} />
    <meta name="twitter:image" content={new URL("/og.png", SITE.website).href} />
    <title>{title}</title>
    <!--
      OTT-71: the page carried no structured data at all, so nothing told a
      crawler or an assistant what Otta IS. Emitted via set:html so the payload
      is JSON built in the frontmatter rather than hand-written markup that can
      drift out of sync with SITE — and a malformed block is discarded whole,
      which is precisely how the PostHog snippet silently died (dev#92).
    -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
    <!-- PostHog Analytics -->
    <script is:inline define:vars={{ phKey: POSTHOG_KEY }}>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);for(r=e,void 0!==a?r=e[a]=[]:a="posthog",r.people=r.people||[],r.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},r.people.toString=function(){return r.toString(1)+".people (stub)"},o="init capture register register_once track_pageview register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment get_group_property onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey getNextSurveyStep identify setPersonProperties group reset resetGroups set_config register_config_callback get_config_callback get_property getSessionId".split(" "),n=0;n<o.length;n++)g(r,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      window.posthog.init(phKey,{api_host:'https://us.i.posthog.com', person_profiles:'identified_only'});
    </script>
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <!-- top nav -->
    <header class="sticky top-0 z-20 border-b border-white/10 bg-slate-950/80 backdrop-blur">
      <nav class="mx-auto flex w-full max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6">
        <a href="/" class="flex items-center gap-2 text-sm font-bold tracking-tight text-white">
          <svg class="h-6 w-6" viewBox="0 0 1024 1024" aria-hidden="true">
            <defs>
              <linearGradient id="navlogo" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#7C6CFF" />
                <stop offset="1" stop-color="#3F2FB8" />
              </linearGradient>
            </defs>
            <rect width="1024" height="1024" rx="232" fill="url(#navlogo)" />
            <path d="M 512 250 A 262 262 0 1 1 304 360" fill="none" stroke="#fff" stroke-width="86" stroke-linecap="round" />
            <circle cx="512" cy="250" r="70" fill="#fff" />
          </svg>
          {BRAND}
        </a>
        <div class="hidden items-center gap-7 text-sm text-slate-300 md:flex">
          <a href="#pipeline" class="hover:text-white">Pipeline</a>
          <a href="#pricing" class="hover:text-white">Pricing</a>
          <a href={SITE.bookingUrl} class="hover:text-white">Book a call</a>
        </div>
        <a
          href={SITE.waitlistUrl}
          class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-indigo-500"
        >
          Get access
        </a>
      </nav>
    </header>

    <main>
      <Hero />
      <Philosophy />
      <Pipeline />
      <Differentiators />
      <Memory />
      <Comparison />
      <Pricing />
      <Waitlist />
      <FinalCta />
    </main>

    <footer class="border-t border-gray-100">
      <div class="mx-auto flex w-full max-w-7xl flex-col items-center justify-between gap-3 px-4 py-8 text-sm text-gray-500 sm:flex-row sm:px-6">
        <span>© {BRAND}. All rights reserved.</span>
      </div>
    </footer>
  </body>
</html>
