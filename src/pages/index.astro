---
import "../styles/global.css";
import { BRAND, SITE } from "../config";
import Hero from "../components/Hero.astro";
import Philosophy from "../components/Philosophy.astro";
import Pipeline from "../components/Pipeline.astro";
import Differentiators from "../components/Differentiators.astro";
import Memory from "../components/Memory.astro";
import Comparison from "../components/Comparison.astro";
import Pricing from "../components/Pricing.astro";
import GetStarted from "../components/GetStarted.astro";
import FinalCta from "../components/FinalCta.astro";
import SeoHead from "../components/SeoHead.astro";
import JsonLd from "../components/JsonLd.astro";
import ConsentMode from "../components/ConsentMode.astro";
import ConsentBanner from "../components/ConsentBanner.astro";

const title = `${BRAND} — ${SITE.tagline}`;
const year = new Date().getFullYear();

// GEO/SEO structured data — SoftwareApplication + Organization (what LLMs cite).
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: BRAND,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Windows, Linux, Web",
    description: SITE.subtitle,
    url: SITE.website,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: BRAND,
    url: SITE.website,
    sameAs: [SITE.jeanUrl],
  },
];

// PostHog project key. Defaults to the dedicated Otta project; override via PUBLIC_POSTHOG_KEY.
const POSTHOG_KEY =
  import.meta.env.PUBLIC_POSTHOG_KEY ?? "phc_xP54prf7PUmJCFrtD9W3zBCEyuM3822XmKuz8HBGNFdh";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <ConsentMode />
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        const f = d.getElementsByTagName(s)[0];
        const j = d.createElement(s);
        const dl = l !== "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-W5J8ZHPR");
    </script>
    <!-- End Google Tag Manager -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead title={title} />
    <JsonLd schema={schema} />
    <!-- PostHog Analytics -->
    <script is:inline define:vars={{ phKey: POSTHOG_KEY }}>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r),r=e,void 0!==a?r=e[a]=[]:a="posthog",r.people=r.people||[],r.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},r.people.toString=function(){return r.toString(1)+".people (stub)"},o="init capture register register_once track_pageview register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment get_group_property onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey getNextSurveyStep identify setPersonProperties group reset resetGroups set_config register_config_callback get_config_callback get_property getSessionId".split(" "),n=0;n<o.length;n++)g(r,o[n]);e._i.push([i,s,a])},e.__SV=1.0)} (document,window.posthog||[]);
      window.posthog.init(phKey,{api_host:'https://us.i.posthog.com', person_profiles:'identified_only'});
    </script>
  </head>
  <body class="bg-zinc-950 text-white antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-W5J8ZHPR"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <!-- top nav -->
    <!-- Nav glow line -->
    <div class="pointer-events-none fixed top-0 left-0 right-0 z-30 h-px bg-gradient-to-r from-transparent via-indigo-500/40 to-transparent"></div>

    <header id="site-header" class="sticky top-0 z-20 transition-all duration-300 border-b border-white/[0.06] bg-zinc-950/75 backdrop-blur-xl">
      <nav class="mx-auto flex w-full max-w-7xl items-center justify-between px-4 py-3 sm:px-6">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 text-sm font-bold tracking-tight text-white shrink-0">
          <div class="relative">
            <svg class="h-7 w-7 drop-shadow-[0_0_8px_rgba(124,108,255,0.6)]" viewBox="0 0 1024 1024" aria-hidden="true">
              <defs>
                <linearGradient id="navlogo" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#818cf8" />
                  <stop offset="1" stop-color="#6d28d9" />
                </linearGradient>
              </defs>
              <rect width="1024" height="1024" rx="232" fill="url(#navlogo)" />
              <path d="M 512 250 A 262 262 0 1 1 304 360" fill="none" stroke="#fff" stroke-width="86" stroke-linecap="round" />
              <circle cx="512" cy="250" r="70" fill="#fff" />
            </svg>
          </div>
          <span class="text-white">{BRAND}</span>
        </a>

        <!-- Desktop links -->
        <div class="hidden items-center gap-1 text-sm md:flex">
          {[
            { href: "#pipeline", label: "Pipeline" },
            { href: "#pricing",  label: "Pricing"  },
            { href: "#get-started", label: "Get started" },
            { href: SITE.bookingUrl, label: "Book a call" },
          ].map(l => (
            <a href={l.href} class="nav-link rounded-md px-3 py-2 text-zinc-200 transition-colors hover:bg-white/[0.07] hover:text-white">
              {l.label}
            </a>
          ))}
        </div>

        <!-- Right side -->
        <div class="flex items-center gap-2">
          <!-- GitHub -->
          <a href="https://github.com/otta-build" target="_blank" rel="noopener noreferrer" aria-label="GitHub"
            class="hidden rounded-md p-2 text-zinc-500 transition-colors hover:bg-white/[0.06] hover:text-white sm:flex">
            <svg class="h-4.5 w-4.5 h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
            </svg>
          </a>

          <!-- CTA -->
          <a href="#get-started"
            class="relative hidden overflow-hidden rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-indigo-600/25 transition-all hover:bg-indigo-500 hover:shadow-indigo-500/30 sm:inline-flex items-center gap-1.5">
            Get started
          </a>

          <!-- Hamburger (mobile only) -->
          <button id="mobile-menu-btn" aria-label="Open menu" aria-expanded="false"
            class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/[0.08] text-zinc-400 transition-colors hover:bg-white/[0.06] hover:text-white md:hidden">
            <svg id="hamburger-icon" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="4" y1="7" x2="20" y2="7"/>
              <line x1="4" y1="12" x2="20" y2="12"/>
              <line x1="4" y1="17" x2="20" y2="17"/>
            </svg>
            <svg id="close-icon" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="5" y1="5" x2="19" y2="19"/>
              <line x1="19" y1="5" x2="5" y2="19"/>
            </svg>
          </button>
        </div>
      </nav>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="mobile-menu-closed overflow-hidden border-t border-white/[0.06] md:hidden">
        <div class="flex flex-col px-4 pb-5 pt-2 space-y-1">
          {[
            { href: "#pipeline",    label: "Pipeline"    },
            { href: "#pricing",     label: "Pricing"     },
            { href: "#get-started", label: "Get started" },
            { href: SITE.bookingUrl, label: "Book a call" },
          ].map(l => (
            <a href={l.href} class="mobile-nav-link rounded-lg px-4 py-3 text-base font-medium text-zinc-300 transition-colors hover:bg-white/[0.06] hover:text-white">
              {l.label}
            </a>
          ))}
          <div class="pt-3 border-t border-white/[0.06] flex items-center gap-3">
            <a href="https://github.com/otta-build" target="_blank" rel="noopener noreferrer"
              class="flex items-center gap-2 rounded-lg px-4 py-3 text-sm font-medium text-zinc-400 transition-colors hover:bg-white/[0.06] hover:text-white">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"/></svg>
              otta-build
            </a>
            <a href="#get-started"
              class="ml-auto rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-600/25 hover:bg-indigo-500 transition-colors">
              Get started
            </a>
          </div>
        </div>
      </div>
    </header>

    <style is:global>
      .mobile-menu-closed { max-height: 0; transition: max-height 0.3s ease; }
      .mobile-menu-open   { max-height: 400px; transition: max-height 0.35s ease; }
      .nav-link { position: relative; }
      .nav-link::after {
        content: "";
        position: absolute; bottom: 4px; left: 12px; right: 12px; height: 1px;
        background: linear-gradient(90deg, transparent, rgba(129,140,248,0.7), transparent);
        opacity: 0; transform: scaleX(0.6); transition: opacity 0.2s, transform 0.2s;
      }
      .nav-link:hover::after { opacity: 1; transform: scaleX(1); }
    </style>

    <script is:inline>
      const btn  = document.getElementById("mobile-menu-btn");
      const menu = document.getElementById("mobile-menu");
      const hIcon = document.getElementById("hamburger-icon");
      const cIcon = document.getElementById("close-icon");

      function toggleMenu(force) {
        const open = force !== undefined ? force : menu.classList.contains("mobile-menu-closed");
        menu.classList.toggle("mobile-menu-open",   open);
        menu.classList.toggle("mobile-menu-closed", !open);
        hIcon.classList.toggle("hidden", open);
        cIcon.classList.toggle("hidden", !open);
        btn.setAttribute("aria-expanded", String(open));
      }

      btn?.addEventListener("click", () => toggleMenu());

      // Close on nav link tap
      document.querySelectorAll(".mobile-nav-link").forEach(l => {
        l.addEventListener("click", () => toggleMenu(false));
      });
    </script>

    </header>

    <!-- Access request modal -->
    <div id="access-modal" class="pointer-events-none fixed inset-0 z-50 flex items-center justify-center p-4 opacity-0 transition-opacity duration-200" aria-modal="true" role="dialog" aria-labelledby="modal-title">
      <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" id="modal-backdrop"></div>
      <div class="relative w-full max-w-md rounded-2xl border border-zinc-800/60 bg-zinc-950 p-8 shadow-2xl shadow-black/60 translate-y-4 transition-transform duration-200" id="modal-card">
        <button id="modal-close" aria-label="Close" class="absolute right-4 top-4 flex h-7 w-7 items-center justify-center rounded-full border border-zinc-800 text-zinc-600 hover:border-zinc-600 hover:text-white transition-colors">
          <svg class="h-3.5 w-3.5" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M1 1l12 12M13 1L1 13"/>
          </svg>
        </button>
        <h2 id="modal-title" class="text-xl font-bold text-white">Request Cockpit access</h2>
        <p class="mt-2 text-sm text-zinc-400">
          The full autonomous pipeline UI — issue management, live run timelines, agent gate approvals. Onboarding in waves.
        </p>
        <form id="modal-form" class="mt-6 flex flex-col gap-3">
          <label for="modal-email" class="sr-only">Email address</label>
          <input
            id="modal-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@company.com"
            class="w-full rounded-lg border border-zinc-800/80 bg-zinc-900/60 px-4 py-3 text-sm text-white placeholder:text-zinc-600 focus:border-indigo-500/60 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
          />
          <button
            type="submit"
            class="rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-indigo-500 disabled:opacity-60 shadow-lg shadow-indigo-600/20"
          >
            Request access
          </button>
        </form>
        <p id="modal-status" class="mt-3 min-h-5 text-sm" role="status" aria-live="polite"></p>
      </div>
    </div>

    <main>
      <Hero />
      <Philosophy />
      <Pipeline />
      <Differentiators />
      <Memory />
      <Comparison />
      <Pricing />
      <GetStarted />
      <FinalCta />
    </main>

    <footer class="border-t border-zinc-900 bg-zinc-950">
      <div class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6">
        <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
          <!-- Brand blurb -->
          <div class="flex flex-col gap-3 max-w-xs">
            <span class="text-sm font-bold text-white">{BRAND}</span>
            <p class="text-xs text-zinc-600 leading-relaxed">
              The self-learning AI software factory.
              GitHub App, executor-agnostic, open core.
            </p>
          </div>

          <!-- Link columns -->
          <div class="grid grid-cols-2 gap-8 text-sm sm:grid-cols-3">
            <div>
              <p class="mb-3 text-[10px] font-bold tracking-[0.15em] text-zinc-700 uppercase">Product</p>
              <ul class="space-y-2.5">
                <li><a href="#pipeline" class="text-zinc-500 hover:text-white transition-colors">Pipeline</a></li>
                <li><a href="#pricing" class="text-zinc-500 hover:text-white transition-colors">Pricing</a></li>
                <li><a href="#get-started" class="text-zinc-500 hover:text-white transition-colors">Get started</a></li>
                <li><a href="/blog" class="text-zinc-500 hover:text-white transition-colors">Blog</a></li>
                <li><a href={SITE.bookingUrl} target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-white transition-colors">Book a call</a></li>
              </ul>
            </div>
            <div>
              <p class="mb-3 text-[10px] font-bold tracking-[0.15em] text-zinc-700 uppercase">Install</p>
              <ul class="space-y-2.5">
                <li>
                  <a href="https://github.com/otta-build/plugin" target="_blank" rel="noopener noreferrer"
                    class="text-zinc-500 hover:text-white transition-colors">Claude Code plugin</a>
                </li>
                <li>
                  <a href={SITE.pulseInstallUrl} target="_blank" rel="noopener noreferrer"
                    class="text-zinc-500 hover:text-white transition-colors">Otta Pulse App</a>
                </li>
              </ul>
            </div>
            <div>
              <p class="mb-3 text-[10px] font-bold tracking-[0.15em] text-zinc-700 uppercase">Links</p>
              <ul class="space-y-2.5">
                <li>
                  <a href="https://github.com/otta-build" target="_blank" rel="noopener noreferrer"
                    class="text-zinc-500 hover:text-white transition-colors">GitHub otta-build</a>
                </li>
                <li>
                  <a href="https://petrenko.cv/" target="_blank" rel="noopener noreferrer"
                    class="text-zinc-500 hover:text-white transition-colors">petrenko.cv</a>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Bottom row -->
        <div class="mt-10 flex flex-col items-center justify-between gap-2 border-t border-zinc-900 pt-6 text-xs text-zinc-700 sm:flex-row">
          <span>{BRAND} — All rights reserved.</span>
          <span>Built by <a href="https://petrenko.cv/" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-400 transition-colors">Sam Petrenko</a></span>
        </div>
      </div>
    </footer>

    <script is:inline>
      // ─── Scroll reveal ───
      (function() {
        var io = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });

        document.querySelectorAll('.reveal, .reveal-left, .reveal-scale').forEach(function(el) {
          io.observe(el);
        });
      })();
    </script>

    <script is:inline>
      // ─── Access request modal ───
      const modal     = document.getElementById("access-modal");
      const modalCard = document.getElementById("modal-card");
      const backdrop  = document.getElementById("modal-backdrop");
      const closeBtn  = document.getElementById("modal-close");
      const modalForm = document.getElementById("modal-form");
      const modalStatus = document.getElementById("modal-status");

      function openModal() {
        modal.classList.remove("pointer-events-none", "opacity-0");
        modal.classList.add("pointer-events-auto", "opacity-100");
        modalCard.classList.remove("translate-y-4");
        document.body.style.overflow = "hidden";
        setTimeout(() => document.getElementById("modal-email").focus(), 50);
      }
      function closeModal() {
        modal.classList.add("pointer-events-none", "opacity-0");
        modal.classList.remove("pointer-events-auto", "opacity-100");
        modalCard.classList.add("translate-y-4");
        document.body.style.overflow = "";
        if (modalStatus) { modalStatus.textContent = ""; modalStatus.className = "mt-3 min-h-5 text-sm"; }
        if (modalForm) modalForm.reset();
      }

      closeBtn.addEventListener("click", closeModal);
      backdrop.addEventListener("click", closeModal);
      document.addEventListener("keydown", e => { if (e.key === "Escape") closeModal(); });

      // Wire all access CTAs to open modal
      document.querySelectorAll("[data-open-modal]").forEach(el => {
        el.addEventListener("click", e => { e.preventDefault(); openModal(); });
      });

      // Form submit
      modalForm.addEventListener("submit", async function(e) {
        e.preventDefault();
        const btn = modalForm.querySelector("button[type=submit]");
        const email = new FormData(modalForm).get("email");
        btn.setAttribute("disabled", "true");
        modalStatus.textContent = "Sending…";
        modalStatus.className = "mt-3 min-h-5 text-sm text-zinc-400";
        try {
          const res = await fetch("/api/waitlist", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ email }),
          });
          const data = await res.json();
          if (res.ok) {
            if (window.posthog) window.posthog.capture("cockpit_access_requested", { email });
            modalStatus.textContent = data.already ? "Already registered — we will be in touch." : "Access request received!";
            modalStatus.className = "mt-3 min-h-5 text-sm text-indigo-400";
            btn.textContent = "Submitted";
          } else {
            modalStatus.textContent = data.error || "Something went wrong.";
            modalStatus.className = "mt-3 min-h-5 text-sm text-rose-400";
            btn.removeAttribute("disabled");
          }
        } catch {
          modalStatus.textContent = "Network error. Try again.";
          modalStatus.className = "mt-3 min-h-5 text-sm text-rose-400";
          btn.removeAttribute("disabled");
        }
      });
    </script>
    <ConsentBanner accentColor="#6366f1" privacyUrl="/privacy" />
  </body>
</html>
