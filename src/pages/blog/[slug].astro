---
import "../../styles/global.css";
import { getCollection, render } from "astro:content";
import { BRAND, SITE } from "../../config";
import ConsentMode from "../../components/ConsentMode.astro";
import ConsentBanner from "../../components/ConsentBanner.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = `${post.data.title} — ${BRAND}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <ConsentMode />
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        const f = d.getElementsByTagName(s)[0];
        const j = d.createElement(s);
        const dl = l !== "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-W5J8ZHPR");
    </script>
    <!-- End Google Tag Manager -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={post.data.description} />
    <link rel="canonical" href={`${SITE.website}blog/${post.id}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={post.data.description} />
    <meta property="og:type" content="article" />
    <title>{title}</title>
  </head>
  <body class="bg-zinc-950 text-white antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-W5J8ZHPR"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <article class="mx-auto max-w-3xl px-6 py-16">
      <a href="/" class="text-sm font-bold tracking-tight text-white">{BRAND}</a>
      <a href="/blog" class="mt-6 block text-xs text-zinc-500 hover:text-indigo-400 transition-colors">&larr; Blog</a>
      <h1 class="mt-6 text-3xl font-bold text-white">{post.data.title}</h1>
      <p class="mt-4 text-xs text-zinc-600">
        {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
      </p>
      <div class="prose prose-invert prose-zinc mt-8 max-w-none prose-a:text-indigo-400 prose-code:text-indigo-300">
        <Content />
      </div>
    </article>
    <ConsentBanner accentColor="#6366f1" privacyUrl="/privacy" />
  </body>
</html>
